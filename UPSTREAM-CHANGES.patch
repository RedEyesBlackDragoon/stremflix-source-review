ckground: #fff;\n    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.25);\n}\n\n/* Stream info */\n#app [class*=\"statistics-menu-container\"] {\n    min-width: 24rem;\n    padding-bottom: 1rem;\n}\n\n#app [class*=\"statistics-menu-container\"] [class*=\"stats\"] {\n    padding: 0 1.5rem;\n    gap: 1.5rem;\n}\n\n#app [class*=\"statistics-menu-container\"] [class*=\"stat-\"] [class*=\"label\"],\n#app [class*=\"statistics-menu-container\"] [class*=\"detail\"] [class*=\"label\"] {\n    font-size: 0.78rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--dx-text-3);\n}\n\n#app [class*=\"statistics-menu-container\"] [class*=\"value\"] {\n    font-size: 1.15rem;\n    font-weight: 700;\n    color: #fff;\n}\n\n#app [class*=\"statistics-menu-container\"] [class*=\"detail\"] {\n    padding: 1rem 1.5rem 0;\n}\n\n#app [class*=\"statistics-menu-container\"] [class*=\"copyable-value\"] {\n    border-radius: var(--dx-radius);\n    background: rgba(255, 255, 255, 0.07) !important;\n}\n\n/* \"More\" options */\n#app [class*=\"options-menu-container\"] {\n    min-width: 17rem;\n    padding: 0.5rem 0;\n}\n\n#app [class*=\"options-menu-container\"] [class*=\"option-container\"] {\n    padding-left: 1.25rem !important;\n    gap: 0.9rem;\n}\n\n#app [class*=\"options-menu-container\"] [class*=\"option-container\"] svg {\n    width: 1.3rem;\n    height: 1.3rem;\n    color: var(--dx-text-2);\n}\n\n/* Episodes side drawer + its handle */\n#app [class*=\"player-container\"] [class*=\"side-drawer-button-layer\"] {\n    width: 2.5rem !important;\n    height: 6rem !important;\n    padding: 0 !important;\n    border-radius: 6px 0 0 6px !important;\n    background: rgba(38, 38, 38, 0.85) !important;\n    border: 0 !important;\n    box-shadow: none !important;\n    backdrop-filter: none !important;\n    transition: background-color 0.2s, width 0.2s;\n}\n\n#app [class*=\"player-container\"] [class*=\"side-drawer-button-layer\"]:hover,\n#app [class*=\"