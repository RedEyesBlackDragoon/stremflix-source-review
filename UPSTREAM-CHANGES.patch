  color: #000 !important;\n}\n\n/* =====================================================================\n   13. STREMIO ENHANCED'S OWN UI (themes/plugins list, alerts)\n   ===================================================================== */\n\n#enhanced [class*=\"option-\"] {\n    border-radius: var(--dx-radius);\n}\n\n#enhanced .install-button-container-yfcq5,\n#enhanced .uninstall-button-container-oV4Yo,\n#enhanced [id$=\".theme.css\"],\n#enhanced [id=\"Default\"] {\n    border-radius: var(--dx-radius) !important;\n}\n\n.toast-container,\n#enhanced-alert-container,\n[class*=\"enhanced-alert\"] {\n    border-radius: var(--dx-radius-l) !important;\n}\n\n/* =====================================================================\n   14. ACCESSIBILITY\n   ===================================================================== */\n\n/* Keyboard focus looks the same as pointing with the mouse (every hover style above also answers\n   to :focus-visible), never a square outline drawn around things */\n:focus-visible {\n    outline: none !important;\n}\n\n@media (prefers-reduced-motion: reduce) {\n    *,\n    *::before,\n    *::after {\n        animation-duration: 0.01ms !important;\n        animation-iteration-count: 1 !important;\n        transition-duration: 0.01ms !important;\n    }\n}\n\n/* =====================================================================\n   15. REFINEMENTS\n   ===================================================================== */\n\n/* Stock hover tooltips sit in the middle of posters — the preview card replaces them.\n   The plugin flags the tooltip box itself while a poster is pointed at: a body:has(...:hover) rule\n   (or any class on <html>/<body>) made the browser restyle the whole page on every hover. */\n.tooltips-items-container[data-dx-hide] {\n    display: none !important;\n}\n\n\n/* Wide card when no backdrop exists: blurred poster + sharp poster */\n.dx-wide-art.is-fallback {\n    background: var(--dx-surface-2) !important;\n}\n\n.dx-wide-blur {\n    position: absolute;\n    inset: -20px;\n    background-size: cover;\n    background-position: center;\n    filter: blur(22px) brightness(0.55) saturate(1.2);\n}\n\n.dx-wide-thumb {\n    position: absolute;\n    top: 0;\n    right: 0;\n    height: 100%;\n    aspect-ratio: 2 / 3;\n    object-fit: cover;\n    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 35%);\n    mask-image: linear-gradient(90deg, transparent 0%, #000 35%);\n}\n\n.dx-wide-art.is-fallback .dx-wide-name {\n    right: 40%;\n    white-space: normal;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n}\n\n/* Addons: actions readable; disabled stays dim */\n#app [class*=\"addon-container\"] [class*=\"uninstall-button-container\"] {\n    opacity: 1 !important;\n}\n\n#app [class*=\"addon-container\"] [class*=\"uninstall-button-container\"].disabled {\n    opacity: 0.35 !important;\n}\n\n#app [class*=\"addon-container\"] [class*=\"configure-button-container\"] {\n    background: var(--dx-surface-2) !important;\n    border: 1px solid var(--dx-line) !important;\n}\n\n#app [class*=\"addon-container\"] [class*=\"configure-button-container\"]:hover,\n#app [class*=\"addon-container\"] [class*=\"configure-button-container\"]:focus-visible {\n    background: var(--dx-surface-3) !important;\n}\n\n#app [class*=\"addon-container\"] [class*=\"configure-button-container\"] * {\n    color: var(--dx-text) !important;\n}\n\n/* Settings: links in white, not accent */\n#app [class*=\"settings-content\"] [class*=\"link-\"],\n#app [class*=\"settings-content\"] a {\n    color: var(--dx-text-2) !important;\n    transition: color 0.2s;\n}\n\n#app [class*=\"settings-content\"] [class*=\"link-\"]:hover,\n#app [class*=\"settings-content\"] a:hover,\n#app [class*=\"settings-content\"] [class*=\"link-\"]:focus-visible,\n#app [class*=\"settings-content\"] a:focus-visible {\n    color: #fff !important;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n}\n\n#app [class*=\"settings-content\"] [class*=\"user-info-content\"] [class*=\"avatar\"] {\n    border: 0 !important;\n    box-shadow: 0 0 0 1px var(--dx-line-strong);\n}\n\n/* =====================================================================\n   16. COMMUNITY PLUGINS (Addon Manager, TheIntroDB, Enhanced Player)\n   ===================================================================== */\n\nhtml:root {\n    --am-accent: var(--dx-accent);\n    --am-bg: var(--dx-bg-raised);\n    --am-border-radius: var(--dx-radius-l);\n}\n\nbody .am-header-btn {\n    height: 2.5rem;\n    border-radius: var(--dx-radius);\n    border: 1px solid var(--dx-line-strong);\n    background: var(--dx-surface);\n    color: var(--dx-text);\n    font-size: 0.9rem;\n}\n\nbody .am-header-btn:hover,\nbody .am-header-btn:focus-visible {\n    background: var(--dx-surface-2);\n    transform: none;\n}\n\nbody .am-header-btn.active {\n    background: var(--dx-accent);\n    border-color: var(--dx-accent);\n    color: #fff;\n}\n\nbody .am-modal {\n    background: var(--dx-surface);\n    border: 1px solid var(--dx-line);\n    border-radius: var(--dx-radius-l);\n}\n\n/* Skip intro / recap button from TheIntroDB */\nbody #tidb-active-btn,\nbody #skiprange-active-btn,\nbody #skiprange-upgrade-btn {\n    padding: 0.85rem 1.5rem 0.85rem 1.25rem !important;\n    border-radius: var(--dx-radius) !important;\n    border: 1.5px solid rgba(255, 255, 255, 0.75) !important;\n    background: rgba(18, 18, 22, 0.72) !important;\n    backdrop-filter: blur(10px) !important;\n    font-family: \"Inter\", sans-serif !important;\n    font-size: 1rem !important;\n    font-weight: 700 !important;\n    letter-spacing: 0.01em;\n    box-shadow: var(--dx-shadow-2);\n}\n\nbody #tidb-active-btn:hover,\nbody #skiprange-active-btn:hover,\nbody #skiprange-upgrade-btn:hover,\nbody #tidb-active-btn:focus-visible,\nbody #skiprange-active-btn:focus-visible,\nbody #skiprange-upgrade-btn:focus-visible {\n    background: #fff !important;\n    color: #000 !important;\n    border-color: #fff !important;\n}\n\n\n/* Enhanced Player title above the seek bar */\n#app .custom-series-name {\n    font-size: 0.8rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--dx-text-2);\n}\n\n#app .custom-episode-title {\n    font-size: 1.05rem;\n    font-weight: 700;\n    color: #fff;\n}\n\n/* Plugin settings dialogs: label above its description, not squeezed beside it */\n[class*=\"modal-dialog-container\"] [class*=\"option-\"] > [class*=\"heading-\"] {\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: flex-start !important;\n    justify-content: center;\n    gap: 0.2rem;\n}\n\n[class*=\"modal-dialog-container\"] [class*=\"option-\"] > [class*=\"heading-\"] > [class*=\"label-\"] {\n    font-weight: 600;\n    color: var(--dx-text);\n}\n\n[class*=\"modal-dialog-container\"] [class*=\"option-\"] > [class*=\"heading-\"] > div:not([class]) {\n    color: var(--dx-text-3) !important;\n    margin-top: 0 !important;\n}\n\n[class*=\"modal-dialog-container\"] select {\n    border-radius: var(--dx-radius) !important;\n    background-color: var(--dx-surface-2) !important;\n    border: 1px solid var(--dx-line) !important;\n}\n\n[class*=\"modal-dialog-container\"] [class*=\"buttons-container\"] [class*=\"action-button\"] {\n    border-radius: var(--dx-radius) !important;\n}\n\n[class*=\"modal-dialog-container\"] [class*=\"option-\"] > [class*=\"heading-\"] {\n    flex: 1 1 auto !important;\n    max-width: none !important;\n    width: auto !important;\n}\n\n[class*=\"modal-dialog-container\"] [class*=\"option-\"] > [class*=\"content-\"]:has([class*=\"toggle-container\"]) {\n    flex: 0 0 auto !important;\n    width: auto !important;\n    max-width: none !important;\n}\n\n#app [class*=\"subtitles-settings-container\"] [class*=\"stepper\"] + [class*=\"stepper\"] {\n    margin-top: 1rem !important;\n}\n\n#app [class*=\"subtitles-settings-container\"] [class*=\"stepper\"] [class*=\"header\"] {\n    margin-bottom: 0.45rem !important;\n}\n\n::-webkit-scrollbar-button {\n    display: none;\n    width: 0;\n    height: 0;\n}\n\n/* =====================================================================\n   17. CONTEXT MENU FIX compatibility\n   That plugin clones the account button (and other menus) into\n   .context-menu-portal outside #app, so give the clones the same look.\n   ===================================================================== */\n\n.context-menu-portal [class*=\"menu-button-container\"] {\n    display: flex !important;\n    align-items: center;\n    gap: 0.4rem;\n    height: 2.5rem !important;\n    padding: 0 0.4rem !important;\n    border-radius: var(--dx-radius) !important;\n    background: rgba(255, 255, 255, 0.08) !important;\n    overflow: visible !important;\n}\n\n.context-menu-portal [class*=\"menu-button-container\"] > [class*=\"avatar\"] {\n    flex: none;\n    width: 2rem !important;\n    height: 2rem !important;\n    border: 0 !important;\n    border-radius: var(--dx-radius-s) !important;\n    overflow: hidden;\n}\n\n.context-menu-portal [class*=\"menu-button-container\"] > [class*=\"avatar\"] img {\n    width: 100% !important;\n    height: 100% !important;\n    object-fit: cover;\n}\n\n.context-menu-portal [class*=\"menu-button-container\"] > svg {\n    flex: none;\n    width: 1.1rem !important;\n    height: 1.1rem !important;\n    color: var(--dx-text);\n}\n\n.context-menu-portal [class*=\"menu-container\"][class*=\"menu-direction\"],\n.context-menu-portal [class*=\"nav-menu-container\"] {\n    border-radius: var(--dx-radius-l) !important;\n    background: rgba(22, 22, 27, 0.97) !important;\n    border: 1px solid var(--dx-line-strong) !important;\n    box-shadow: var(--dx-shadow-2) !important;\n    overflow: hidden;\n}\n\n.context-menu-portal [class*=\"menu-container\"][class*=\"menu-direction\"] [class*=\"nav-menu-container\"] {\n    border: 0 !important;\n    box-shadow: none !important;\n}\n\n/* Account menu (both in-app and cloned) */\n[class*=\"nav-menu-container\"] [class*=\"user-info-container\"] [class*=\"avatar\"],\n[class*=\"nav-menu-container\"] [class*=\"avatar\"] {\n    border: 0 !important;\n    border-radius: var(--dx-radius) !important;\n    box-shadow: 0 0 0 1px var(--dx-line-strong);\n}\n\n[class*=\"nav-menu-container\"] [class*=\"nav-menu-option-container\"] {\n    border-radius: var(--dx-radius);\n    transition: background-color 0.15s;\n}\n\n[class*=\"nav-menu-container\"] [class*=\"nav-menu-option-container\"]:hover,\n[class*=\"nav-menu-container\"] [class*=\"nav-menu-option-container\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.08) !important;\n}\n\n[class*=\"nav-menu-container\"] [class*=\"nav-menu-option-container\"] svg {\n    color: var(--dx-text-2);\n}\n\n\n/* =====================================================================\n   18. ENHANCED VIDEO PLAYER compatibility (subtitle style panel + title)\n   ===================================================================== */\n\n/* Stremflix shows the title in the control bar; hide the duplicate */\nbody[data-dx-ptitle] #app .custom-series-name,\nbody[data-dx-ptitle] #app .custom-episode-title {\n    display: none !important;\n}\n\n#app [class*=\"subtitles-menu-container\"] .enhanced-subtitle-customize-section {\n    width: 22rem;\n    max-height: 100%;\n    padding: 0 1.5rem 1.25rem;\n    overflow-y: auto;\n    border-left: 1px solid rgba(255, 255, 255, 0.08);\n    font-size: 0.9rem;\n    color: var(--dx-text-2);\n}\n\n#app .enhanced-subtitle-customize-header {\n    display: flex;\n    align-items: center;\n    padding: 1.35rem 0 0.75rem;\n    font-size: 0 !important;\n}\n\n#app .enhanced-subtitle-customize-header > * {\n    display: none !important;\n}\n\n#app .enhanced-subtitle-customize-header::after {\n    content: \"Style\";\n    font-size: 1.3rem;\n    font-weight: 700;\n    color: #fff;\n}\n\n#app .enhanced-subtitle-presets-bar {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.4rem;\n    margin-bottom: 1rem;\n}\n\n#app .enhanced-subtitle-preset-btn {\n    height: 2rem;\n    padding: 0 0.85rem;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.07);\n    border: 1px solid transparent;\n    font-size: 0.82rem;\n    font-weight: 600;\n    color: var(--dx-text-2);\n    cursor: pointer;\n    transition: background-color 0.15s, color 0.15s;\n}\n\n#app .enhanced-subtitle-preset-btn:hover,\n#app .enhanced-subtitle-preset-btn:focus-visible {\n    background: rgba(255, 255, 255, 0.12);\n    color: #fff;\n}\n\n#app .enhanced-subtitle-preset-btn.selected {\n    background: #fff;\n    color: #000;\n}\n\n#app .enhanced-subtitle-preview-section {\n    margin-bottom: 1rem;\n}\n\n#app .enhanced-subtitle-preview-label,\n#app .enhanced-stepper-header,\n#app .enhanced-select-header,\n#app .enhanced-color-header,\n#app .enhanced-text-header {\n    margin-bottom: 0.4rem;\n    font-size: 0.72rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--dx-text-3);\n}\n\n#app .enhanced-subtitle-preview-box {\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n    height: 5.5rem;\n    padding: 0.75rem;\n    border-radius: var(--dx-radius);\n    background:\n        linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.35)),\n        url(\"https://images.metahub.space/background/medium/tt1375666/img\") center / cover,\n        #333;\n    overflow: hidden;\n}\n\n#app .enhanced-subtitle-preview-text {\n    max-width: 100%;\n    text-align: center;\n    white-space: normal;\n}\n\n#app .enhanced-settings-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 0.85rem 0.75rem;\n}\n\n#app .enhanced-stepper-content {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    height: 2.5rem;\n    border-radius: var(--dx-radius);\n    background: rgba(255, 255, 255, 0.07);\n}\n\n#app .enhanced-st