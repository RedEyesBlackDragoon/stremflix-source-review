ub {\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n    pointer-events: none;\n    overflow: visible !important;\n}\n\n/* lighter fill from the playhead to the cursor */\n.dx-scrub-fill {\n    position: absolute;\n    top: 50%;\n    height: var(--track-size, 4px);\n    transform: translateY(-50%);\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.35);\n    opacity: 0;\n    transition: opacity 0.15s;\n}\n\n.dx-scrub.is-on .dx-scrub-fill {\n    opacity: 1;\n}\n\n.dx-scrub-tip {\n    position: absolute;\n    bottom: calc(100% + 1.1rem);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 0.45rem;\n    transform: translateX(-50%) translateY(6px);\n    opacity: 0;\n    transition: opacity 0.15s ease, transform 0.15s ease;\n}\n\n.dx-scrub.is-on .dx-scrub-tip {\n    opacity: 1;\n    transform: translateX(-50%);\n}\n\n.dx-scrub-frame {\n    display: none;\n    width: 16rem;\n    border: 2px solid rgba(255, 255, 255, 0.9);\n    border-radius: 6px;\n    background: #000;\n    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);\n    overflow: hidden !important;\n}\n\n.dx-scrub.has-frame .dx-scrub-frame,\n.dx-scrub.is-loading .dx-scrub-frame {\n    display: block;\n}\n\n/* loading: a 16:9 dark box with a soft moving sheen until the frame arrives */\n.dx-scrub.is-loading:not(.has-frame) .dx-scrub-frame {\n    position: relative;\n    aspect-ratio: 16 / 9;\n    background: #141414;\n}\n\n.dx-scrub.is-loading:not(.has-frame) .dx-scrub-frame canvas {\n    visibility: hidden;\n}\n\n.dx-scrub.is-loading:not(.has-frame) .dx-scrub-frame::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, 0.08) 50%, transparent 70%);\n    animation: dx-scrub-sheen 1.1s linear infinite;\n}\n\n@keyframes dx-scrub-sheen {\n    from { transform: translateX(-100%); }\n    to { transform: translateX(100%); }\n}\n\n.dx-scrub-frame canvas {\n    display: block;\n    