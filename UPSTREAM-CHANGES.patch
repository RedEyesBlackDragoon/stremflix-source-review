eam Finder,\n   FilterStreams, Stream Quality Picker…). Anything a plugin inserts next to\n   the streams/episodes panel is stacked on top of it as one column.\n   ===================================================================== */\n\n#app [class*=\"metadetails-content\"]:has(> :not([class*=\"meta-preview\"]):not([class*=\"spacing\"]):not([class*=\"streams-list\"]):not([class*=\"videos-list\"])) {\n    display: grid !important;\n    grid-template-columns: minmax(0, 1fr) clamp(28rem, 31vw, 42rem);\n    grid-template-rows: auto auto auto minmax(0, 1fr);\n    column-gap: 1.5rem;\n    padding-right: var(--dx-gutter) !important;\n}\n\n#app [class*=\"metadetails-content\"]:has(> :not([class*=\"meta-preview\"]):not([class*=\"spacing\"]):not([class*=\"streams-list\"]):not([class*=\"videos-list\"])) > [class*=\"meta-preview\"] {\n    grid-column: 1;\n    grid-row: 1 / -1;\n    min-height: 0;\n}\n\n#app [class*=\"metadetails-content\"]:has(> :not([class*=\"meta-preview\"]):not([class*=\"spacing\"]):not([class*=\"streams-list\"]):not([class*=\"videos-list\"])) > [class*=\"spacing\"] {\n    display: none !important;\n}\n\n#app [class*=\"metadetails-content\"] > :not([class*=\"meta-preview\"]):not([class*=\"spacing\"]):not([class*=\"streams-list\"]):not([class*=\"videos-list\"]) {\n    grid-column: 2;\n    width: auto !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0.85rem 1rem !important;\n    background: rgba(19, 19, 23, 0.86) !important;\n    border: 1px solid var(--dx-line);\n    border-bottom: 0;\n    backdrop-filter: blur(24px) saturate(140%);\n    z-index: 2;\n}\n\n#app [class*=\"metadetails-content\"] > :not([class*=\"meta-preview\"]):not([class*=\"spacing\"]):not([class*=\"streams-list\"]):not([class*=\"videos-list\"]):first-of-type,\n#app [class*=\"metadetails-content\"] > [class*=\"spacing\"] + :not([class*=\"streams-list\"]):not([class*=\"videos-list\"]) {\n    margin-top: 0.75rem !important;\n    border-radius: var(--dx-radius-l) var(--dx-radius-l) 0 0;\n}\n\n#app [class*=\"metadetails-content\"]:has(> :not([class*=\"meta-preview\"]):not([class*=\"spacing\"]):not([class*=\"streams-list\"]):not([class*=\"videos-list\"])) > [class*=\"streams-list\"],\n#app [class*=\"metadetails-content\"]:has(> :not([class*=\"meta-preview\"]):not([class*=\"spacing\"]):not([class*=\"streams-list\"]):not([class*=\"videos-list\"])) > [class*=\"videos-list\"] {\n    grid-column: 2;\n    grid-row: 4;\n    width: auto !important;\n    flex: none !important;\n    min-height: 0;\n    margin: 0 0 1.5rem 0 !important;\n    border-top-left-radius: 0 !important;\n    border-top-right-radius: 0 !important;\n    animation: none;\n}\n\n/* Chips / inputs that stream plugins add: match Stremflix */\n#app [class*=\"metadetails-content\"] [class*=\"chip\"]:not([class*=\"chips\"]) {\n    border-radius: 999px;\n}\n\n/* AniSkip shows its buttons inside Stremio's \"up next\" popup */\n#app [id^=\"skip-\"][id$=\"-button\"] {\n    border-radius: var(--dx-radius) !important;\n    background: #fff !important;\n}\n\n#app [id^=\"skip-\"][id$=\"-button\"] * {\n    color: #000 !important;\n}\n\n/* =====================================================================\n   20. STREAM SORT & FILTER BAR (plugin)\n   ===================================================================== */\n\n/* Sorting uses CSS order, so the list must be a flex column */\n#app [class*=\"streams-container\"].dx-sortable {\n    display: flex !important;\n    flex-direction: column;\n}\n\n#app [class*=\"streams-container\"].dx-sortable > [data-dx-hide] {\n    display: none !important;\n}\n\n.dx-streambar {\n    flex: none;\n    padding: 0.85rem 0.85rem 0.75rem;\n    border-bottom: 1px solid var(--dx-line);\n    overflow: visible !important;\n}\n\n.dx-streambar[hidden] {\n    display: none;\n}\n\n.dx-sb-row {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.4rem;\n    overflow: visible !important;\n}\n\n.dx-sb-btn {\n    display: