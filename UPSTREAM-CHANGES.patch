\n    border-radius: 2px;\n    background: var(--dx-accent);\n    transform: scaleX(0);\n    transform-origin: left;\n    transition: transform 0.35s var(--dx-ease-out);\n}\n\n#app nav[class*=\"vertical-nav-bar\"] a[class*=\"nav-tab-button\"].selected::after {\n    transform: scaleX(1);\n}\n\n/* \"Board\" reads as \"Home\" */\n#app nav[class*=\"vertical-nav-bar\"] a[href=\"#/\"] [class*=\"label\"] {\n    font-size: 0 !important;\n}\n\n#app nav[class*=\"vertical-nav-bar\"] a[href=\"#/\"] [class*=\"label\"]::after {\n    content: \"Home\";\n    font-size: 0.92rem;\n}\n\n/* Search: compact field on the right */\n#app [class*=\"main-nav-bars-container\"] nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"] {\n    flex: none;\n    order: 1;\n    width: 15rem;\n    height: 2.4rem;\n    padding: 0 0.35rem 0 0.9rem;\n    border-radius: var(--dx-radius);\n    background: rgba(255, 255, 255, 0.06);\n    border: 1px solid var(--dx-line);\n    transition: width 0.4s var(--dx-ease-out), background-color 0.25s, border-color 0.25s;\n}\n\n#app [class*=\"main-nav-bars-container\"] nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"]:hover,\n#app [class*=\"main-nav-bars-container\"] nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.09);\n}\n\n#app [class*=\"main-nav-bars-container\"] nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"]:focus-within,\n#app [class*=\"main-nav-bars-container\"] nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"].active {\n    width: 22rem;\n    background: rgba(0, 0, 0, 0.85);\n    border-color: rgba(255, 255, 255, 0.55);\n}\n\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"] [class*=\"search-input\"],\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"] input {\n    font-size: 0.9rem;\n    color: var(--dx-text);\n}\n\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"] [class*=\"placeholder-label\"] {\n    font-size: 0.9rem;\n    color: var(--dx-text-3);\n    opacity: 1;\n}\n\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"] [class*=\"submit-button-container\"] {\n    width: 2rem;\n    height: 2rem;\n    padding: 0;\n    border-radius: var(--dx-radius-s);\n}\n\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"] svg {\n    width: 1.1rem;\n    height: 1.1rem;\n    color: var(--dx-text-2);\n    opacity: 1;\n}\n\n/* Right-hand buttons */\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"buttons-container\"] {\n    flex: none;\n    order: 2;\n    gap: 0.35rem;\n}\n\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"buttons-container\"] > [class*=\"button-container\"] {\n    height: 2.5rem;\n    min-width: 2.5rem;\n    border-radius: var(--dx-radius);\n    background: transparent;\n    transition: background-color 0.2s;\n}\n\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"buttons-container\"] > [class*=\"button-container\"]:hover,\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"buttons-container\"] > [class*=\"button-container\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.08);\n}\n\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"buttons-container\"] svg {\n    width: 1.3rem;\n    height: 1.3rem;\n    color: var(--dx-text);\n    opacity: 0.9;\n}\n\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"avatar\"] {\n    width: 2rem;\n    height: 2rem;\n    border: 0 !important;\n    border-radius: var(--dx-radius-s) !important;\n}\n\n#app nav[class*=\"horizontal-nav-bar\"] [class*=\"avatar\"] img {\n    border-radius: var(--dx-radius-s) !important;\n}\n\n/* Content starts under the header; full width (no sidebar) */\n#app [class*=\"main-nav-bars-container\"] > [class*=\"nav-content-container\"] {\n    top: var(--dx-nav-h);\n    left: 0;\n}\n\nbody[data-dx-route=\"board\"] #app [class*=\"board-container\"] [class*=\"nav-content-container\"] {\n    top: 0;\n}\n\n/* Narrower windows */\n@media (max-width: 1450px) {\n    #app [class*=\"main-nav-bars-container\"] > nav[class*=\"vertical-nav-bar\"] {\n        gap: 1.25rem;\n    }\n\n    #app [class*=\"main-nav-bars-container\"] nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"] {\n        width: 2.6rem;\n        padding: 0 0.25rem;\n        background: transparent;\n        border-color: transparent;\n    }\n\n    #app [class*=\"main-nav-bars-container\"] nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"] [class*=\"search-input\"] {\n        opacity: var(--dx-search-open, 0);\n    }\n\n    #app [class*=\"main-nav-bars-container\"] nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"]:focus-within,\n    #app [class*=\"main-nav-bars-container\"] nav[class*=\"horizontal-nav-bar\"] [class*=\"search-bar-container\"].active {\n        position: relative;\n        z-index: 7;\n        width: 18rem;\n        padding: 0 0.35rem 0 0.9rem;\n        --dx-search-open: 1;\n    }\n}\n\n@media (max-width: 1000px) {\n    #app nav[class*=\"vertical-nav-bar\"] a[class*=\"nav-tab-button\"] [class*=\"label\"] {\n        display: none;\n    }\n\n    #app nav[class*=\"vertical-nav-bar\"] a[class*=\"nav-tab-button\"] svg {\n        display: block;\n        width: 1.35rem;\n        height: 1.35rem;\n        color: var(--dx-text-2);\n    }\n\n    #app nav[class*=\"vertical-nav-bar\"] a[class*=\"nav-tab-button\"].selected svg {\n        color: #fff;\n    }\n}\n\n/* =====================================================================\n   4. BOARD — rows become carousels\n   ===================================================================== */\n\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) {\n    padding: 0 0 4rem 0 !important;\n    overflow-x: hidden;\n    scroll-behavior: smooth;\n}\n\n/* No billboard (plugin off): keep rows clear of the floating header */\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]):not(:has(> .dx-hero)) {\n    padding-top: calc(var(--dx-nav-h) + 1rem) !important;\n}\n\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) [class*=\"board-row\"],\n#app [class*=\"search-content\"] [class*=\"search-row\"] {\n    position: relative;\n    margin: 0 0 1.4rem 0 !important;\n}\n\n/* Rows that only show an addon error are noise — hide them */\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) [class*=\"board-row\"]:has(> [class*=\"message-container\"]),\n#app [class*=\"search-content\"] [class*=\"search-row\"]:has(> [class*=\"message-container\"]) {\n    display: none !important;\n}\n\n#app [class*=\"meta-row\"] > [class*=\"header-container\"] {\n    padding: 0 var(--dx-gutter) !important;\n    margin: 0 0 0.1rem 0;\n    height: 2.5rem;\n}\n\n#app [class*=\"meta-row\"] > [class*=\"header-container\"] [class*=\"title-container\"] {\n    font-size: clamp(1.05rem, 1.25vw, 1.45rem) !important;\n    font-weight: 700 !important;\n    letter-spacing: -0.005em;\n    color: var(--dx-text);\n    max-height: none;\n}\n\n#app [class*=\"meta-row\"] > [class*=\"header-container\"] [class*=\"title-container\"] [class*=\"title\"] {\n    font-size: inherit !important;\n    font-weight: inherit !important;\n}\n\n#app [class*=\"meta-row\"] [class*=\"see-all-container\"] {\n    height: 2rem;\n    padding: 0 0.4rem 0 0.75rem;\n    border-radius: var(--dx-radius-s);\n    opacity: var(--dx-row-hot, 0);\n    transform: translateX(calc(6px * (var(--dx-row-hot, 0) - 1)));\n    transition: opacity 0.3s, transform 0.3s var(--dx-ease-out), background-color 0.2s;\n}\n\n#app [class*=\"meta-row\"]:hover,\n#app [class*=\"meta-row\"]:focus-visible {\n    --dx-row-hot: 1;\n}\n\n#app [class*=\"meta-row\"] [class*=\"see-all-container\"]:hover,\n#app [class*=\"meta-row\"] [class*=\"see-all-container\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.07);\n}\n\n#app [class*=\"meta-row\"] [class*=\"see-all-container\"] [class*=\"label\"] {\n    font-size: 0.82rem;\n    font-weight: 600;\n    color: var(--dx-text-2);\n}\n\n#app [class*=\"meta-row\"] [class*=\"see-all-container\"] svg {\n    height: 1rem;\n    color: var(--dx-text-2);\n}\n\n/* Rows fade softly into the screen edges: titles that slide aside for a hover card (or peek in\n   from a scrolled row) glide out of view instead of being sliced off at the edge */\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) [class*=\"meta-row\"] > [class*=\"meta-items-container\"],\n#app [class*=\"search-content\"] [class*=\"meta-row\"] > [class*=\"meta-items-container\"] {\n    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 calc(var(--dx-gutter) - 0.6rem), #000 calc(100% - var(--dx-gutter) + 0.6rem), transparent 100%);\n    mask-image: linear-gradient(90deg, transparent 0, #000 calc(var(--dx-gutter) - 0.6rem), #000 calc(100% - var(--dx-gutter) + 0.6rem), transparent 100%);\n}\n\n/* The track */\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) [class*=\"meta-row\"] > [class*=\"meta-items-container\"],\n#app [class*=\"search-content\"] [class*=\"meta-row\"] > [class*=\"meta-items-container\"] {\n    display: flex !important;\n    flex-wrap: nowrap;\n    overflow-x: auto !important;\n    overflow-y: hidden !important;\n    scroll-behavior: smooth;\n    scroll-snap-type: x proximity;\n    scroll-padding-inline: var(--dx-gutter);\n    scrollbar-width: none;\n    padding: 0.9rem calc(var(--dx-gutter) - 0.35rem) 1.1rem;\n    margin: -0.65rem 0 -0.35rem;\n    overscroll-behavior-x: contain;\n}\n\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) [class*=\"meta-row\"] > [class*=\"meta-items-container\"]::-webkit-scrollbar,\n#app [class*=\"search-content\"] [class*=\"meta-row\"] > [class*=\"meta-items-container\"]::-webkit-scrollbar {\n    display: none;\n}\n\n/* Show every item (stock hides some by screen width) */\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) [class*=\"meta-row\"] > [class*=\"meta-items-container\"] > *,\n#app [class*=\"search-content\"] [class*=\"meta-row\"] > [class*=\"meta-items-container\"] > * {\n    display: block !important;\n    flex: 0 0 calc(100% / var(--dx-cols)) !important;\n    max-width: none !important;\n    padding: 0 0.35rem !important;\n    scroll-snap-align: start;\n}\n\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) [class*=\"meta-row\"] > [class*=\"meta-items-container\"] > *:empty,\n#app [class*=\"search-content\"] [class*=\"meta-row\"] > [class*=\"meta-items-container\"] > *:empty {\n    display: none !important;\n}\n\n/* Landscape rows (and Continue Watching, made landscape by the plugin) */\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) [class*=\"board-row-landscape\"] > [class*=\"meta-items-container\"] > *,\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) [class*=\"continue-watching-row\"][data-dx-wide-row] > [class*=\"meta-items-container\"] > * {\n    flex-basis: calc(100% / var(--dx-wide-cols, 4)) !important;\n}\n\n/* =====================================================================\n   5. POSTER CARDS (everywhere)\n   ===================================================================== */\n\n#app [class*=\"meta-item-container\"] {\n    padding: 0.5rem 0.35rem;\n    transition: transform 0.35s var(--dx-ease-out);\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"poster-container\"] {\n    border-radius: var(--dx-radius) !important;\n    background: var(--dx-surface);\n    box-shadow: none !important;\n    overflow: hidden;\n    transform: translate3d(0, calc(-4px * var(--dx-card-focus, 0)), 0) scale(calc(1 + 0.035 * var(--dx-card-focus, 0)));\n    transition: transform 0.35s var(--dx-ease-out), box-shadow 0.35s var(--dx-ease-out) !important;\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"poster-container\"]::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    border-radius: inherit;\n    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);\n    pointer-events: none;\n    z-index: 5;\n    transition: box-shadow 0.3s;\n}\n\n#app [class*=\"meta-item-container\"]:is(.hovered, .active, .selected) [class*=\"poster-container\"] {\n    box-shadow: var(--dx-shadow-2) !important;\n    transform: translateY(-4px) scale(1.035);\n}\n\n/* keyboard highlight: the poster lifts like it does under the mouse, and the hover card shows\n   what's selected: no outline or ring around the card */\n#app [class*=\"meta-item-link\"]:focus-visible {\n    --dx-card-focus: 1;\n    outline: none !important;\n}\n\n#app [class*=\"meta-item-container\"]:active:not(.active) {\n    --dx-card-press: 1;\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"poster-container\"] {\n    scale: calc(1 - 0.03 * var(--dx-card-press, 0));\n}\n\n#app [class*=\"meta-item-container\"]:is(.hovered, .active, .selected) [class*=\"poster-container\"]::after {\n    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.85);\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"poster-image-layer\"] {\n    transition: transform 0.6s var(--dx-ease-out) !important;\n}\n\n#app [class*=\"meta-item-container\"].hovered [class*=\"poster-image-layer\"] {\n    transform: scale(1.04) !important;\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"poster-image\"] {\n    object-fit: cover;\n}\n\n\n/* Titles under cards: quiet, single line */\n#app [class*=\"meta-item-container\"] [class*=\"title-bar-container\"] {\n    height: auto;\n    min-height: 0;\n    padding: 0.55rem 0.15rem 0 0.15rem;\n    justify-content: flex-start;\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"title-bar-container\"] [class*=\"title-label\"] {\n    padding: 0;\n    font-size: 0.85rem;\n    font-weight: 500;\n    color: var(--dx-text-2);\n    text-align: left;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n    max-height: 1.3em;\n    transition: color 0.2s;\n}\n\n#app [class*=\"meta-item-container\"].hovered [class*=\"title-bar-container\"] [class*=\"title-label\"] {\n    color: var(--dx-text);\n}\n\n/* Rows on Home/Search: artwork only, like the real thing (titles live in the preview card) */\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) [class*=\"meta-row\"] [class*=\"meta-item-container\"] [class*=\"title-bar-container\"],\n#app [class*=\"search-content\"] [class*=\"meta-row\"] [class*=\"meta-item-container\"] [class*=\"title-bar-container\"] {\n    display: none;\n}\n\n/* Progress */\n#app [class*=\"meta-item-container\"] [class*=\"progress-bar-layer\"] {\n    left: 0.6rem;\n    right: 0.6rem;\n    bottom: 0.6rem;\n    height: 3px;\n    border-radius: 3px;\n    overflow: hidden;\n}\n\n#app [class*=\"progress-bar-layer\"] [class*=\"progress-bar-background\"] {\n    background: rgba(255, 255, 255, 0.28) !important;\n    opacity: 1 !important;\n}\n\n#app [class*=\"progress-bar-layer\"] [class*=\"progress-bar\"]:not([class*=\"background\"]),\n#app [class*=\"progress-bar-container\"] [class*=\"progress-bar\"]:not([class*=\"background\"]) {\n    background: var(--dx-accent) !important;\n}\n\n/* Play overlay on Continue Watching */\n#app [class*=\"meta-item-container\"] [class*=\"play-icon-layer\"] {\n    opacity: 0;\n    transition: opacity 0.25s;\n}\n\n#app [class*=\"meta-item-container\"].hovered [class*=\"play-icon-layer\"] {\n    opacity: 1;\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"play-icon-background\"] {\n    background: rgba(0, 0, 0, 0.55) !important;\n    border: 2px solid rgba(255, 255, 255, 0.9);\n    opacity: 1 !important;\n    backdrop-filter: blur(6px);\n}\n\n#app [class*=\"meta-item-container\"].hovered [class*=\"play-icon-background\"] {\n    background: var(--dx-accent) !important;\n    border-color: var(--dx-accent);\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"play-icon-outer\"] {\n    display: none;\n}\n\n/* Watched tick */\n#app [class*=\"meta-item-container\"] [class*=\"watched-icon-layer\"] {\n    background: rgba(0, 0, 0, 0.7);\n    border-radius: 50%;\n    backdrop-filter: blur(4px);\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"watched-icon\"] {\n    color: #fff;\n}\n\n/* \"New episodes\" stack */\n#app [class*=\"meta-item-container\"] [class*=\"new-videos\"] [class*=\"layer\"]:last-child {\n    background: var(--dx-accent) !important;\n    border-radius: var(--dx-radius-s);\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"new-videos\"] [class*=\"layer\"]:not(:last-child) {\n    background: color-mix(in srgb, var(--dx-accent) 55%, black) !important;\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"new-videos\"] [class*=\"label\"],\n#app [class*=\"meta-item-container\"] [class*=\"new-videos\"] svg {\n    color: #fff !important;\n}\n\n/* Dismiss on Continue Watching: a slim glass tab that opens out into \"Remove\" when pointed at.\n   It takes the corner from the \"+N new episodes\" badge while the card is hovered. */\n#app [class*=\"meta-item-container\"] [class*=\"dismiss-icon-layer\"] {\n    z-index: 7 !important;\n    top: 0.6rem;\n    left: auto;\n    right: 0.6rem;\n    width: auto !important;\n    height: 1.55rem !important;\n    min-width: 1.55rem;\n    padding: 0 0.42rem;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 0.4rem;\n    background: rgba(12, 12, 14, 0.62);\n    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16), 0 4px 14px rgba(0, 0, 0, 0.35);\n    backdrop-filter: blur(8px);\n    opacity: 0;\n    transform: translateY(-2px);\n    transition: opacity 0.18s ease, transform 0.18s ease, background-color 0.15s ease, box-shadow 0.15s ease;\n}\n\n#app [class*=\"meta-item-container\"].hovered [class*=\"dismiss-icon-layer\"],\n#app [class*=\"meta-item-container\"] [class*=\"dismiss-icon-layer\"]:focus-visible {\n    opacity: 1;\n    transform: none;\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"dismiss-icon-backdrop\"] {\n    display: none !important;\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"dismiss-icon-layer\"] svg {\n    position: static !important;\n    flex: none;\n    width: 0.62rem !important;\n    height: 0.62rem !important;\n    color: #fff !important;\n    fill: currentColor !important;\n    opacity: 1;\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"dismiss-icon-layer\"]::before {\n    content: \"Remove\";\n    max-width: 0;\n    overflow: hidden;\n    white-space: nowrap;\n    color: #fff;\n    font: 600 0.72rem/1 Inter, system-ui, sans-serif;\n    letter-spacing: 0.02em;\n    transition: max-width 0.22s ease, margin 0.22s ease;\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"dismiss-icon-layer\"]:hover,\n#app [class*=\"meta-item-container\"] [class*=\"dismiss-icon-layer\"]:focus-visible {\n    background: var(--dx-accent);\n    box-shadow: 0 4px 16px color-mix(in srgb, var(--dx-accent) 45%, transparent);\n}\n\n#app [class*=\"meta-item-container\"] [class*=\"dismiss-icon-layer\"]:hover::before,\n#app [class*=\"meta-item-container\"] [class*=\"dismiss-icon-layer\"]:focus-visible::before {\n    max-width: 4.5rem;\n    margin-right: 0.4rem;\n}\n\n/* the \"+N\" badge steps aside while the remove tab is showing */\n#app [class*=\"meta-item-container\"] [class*=\"new-videos\"] {\n    transition: opacity 0.18s ease;\n}\n\n#app [class*=\"continue-watching-row\"] [class*=\"meta-item-container\"].hovered [class*=\"new-videos\"] {\n    opacity: 0;\n}\n\n/* Card menu dots */\n#app [class*=\"meta-item-container\"] [class*=\"menu-label-container\"] {\n    border-radius: var(--dx-radius-s);\n}\n\n/* Placeholders while loading */\n#app [class*=\"meta-row-placeholder-container\"] [class*=\"poster-container\"],\n#app [class*=\"meta-item-placeholder\"] [class*=\"poster-container\"],\n#app [class*=\"placeholder\"] [class*=\"poster-container\"] {\n    border-radius: var(--dx-radius) !important;\n    /* static on purpose: rows from broken addons stay placeholders forever, and an endless\n       animation on dozens of them would cost CPU the whole time Home is open */\n    background: var(--dx-surface) !important;\n    animation: none !important;\n}\n\n#app [class*=\"meta-row-placeholder-container\"] [class*=\"title-bar-container\"],\n#app [class*=\"meta-row-placeholder-container\"] [class*=\"title-label\"] {\n    display: none;\n}\n\n#app [class*=\"meta-row-placeholder-container\"] [class*=\"header-container\"] [class*=\"title-container\"] {\n    width: 14rem;\n    height: 1.1rem;\n    border-radius: var(--dx-radius-s);\n    background: var(--dx-surface);\n    color: transparent !important;\n}\n\n\n/* =====================================================================\n   6. BILLBOARD (built by the plugin)\n   ===================================================================== */\n\n.dx-hero {\n    position: relative;\n    width: 100%;\n    height: min(82vh, 56.25vw);\n    min-height: 26rem;\n    margin-bottom: -6vw;\n    overflow: hidden;\n    background: var(--dx-bg);\n    isolation: isolate;\n    animation: dx-fade 0.8s var(--dx-ease) both;\n}\n\n.dx-hero-slide {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n}\n\n.dx-hero-slide.is-active {\n    pointer-events: auto;\n}\n\n/* Only the pictures cross-fade; the text is handled separately so it never looks washed out */\n.dx-hero-backdrop {\n    position: absolute;\n    inset: 0;\n    opacity: 0;\n    background-size: cover;\n    background-position: center 20%;\n    transform: scale(1.06);\n    transform-origin: 70% 40%;\n    transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);\n    will-change: transform, opacity;\n}\n\n.dx-hero-slide.is-active .dx-hero-backdrop {\n    opacity: 1;\n}\n\n/* The slow zoom keeps running on the outgoing picture until it has faded (class managed by the plugin) */\n.dx-hero-backdrop.kb {\n    animation: dx-kenburns 16s linear both;\n}\n\n@keyframes dx-kenburns {\n    from { transform: scale(1.06) translate3d(0, 0, 0); }\n    to { transform: scale(1.14) translate3d(-1.2%, -1%, 0); }\n}\n\n.dx-hero-shade {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    pointer-events: none;\n    background:\n        linear-gradient(90deg, rgba(11, 11, 13, 0.92) 0%, rgba(11, 11, 13, 0.6) 28%, rgba(11, 11, 13, 0.08) 58%, transparent 75%),\n        linear-gradient(0deg, var(--dx-bg) 0%, rgba(11, 11, 13, 0.75) 14%, rgba(11, 11, 13, 0) 42%),\n        linear-gradient(180deg, rgba(0, 0, 0, 0.45) 0%, transparent 18%);\n}\n\n.dx-hero-content {\n    position: absolute;\n    z-index: 2;\n    left: var(--dx-gutter);\n    bottom: calc(6vw + 4.5rem);\n    width: min(36rem, 42vw);\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 1rem;\n}\n\n/* Old text fades out first, then the new text fades in — never both at once, never moving,\n   so it stays crisp the whole time */\n.dx-hero-slide .dx-hero-content {\n    opacity: 0;\n    visibility: hidden;\n    transition: opacity 0.3s ease, visibility 0s linear 0.3s;\n}\n\n.dx-hero-slide.is-active .dx-hero-content {\n    opacity: 1;\n    visibility: visible;\n    transition: opacity 0.6s ease 0.45s, visibility 0s linear 0.45s;\n}\n\n/* First appearance on load: no waiting */\n.dx-hero.is-first .dx-hero-slide.is-active .dx-hero-content {\n    transition-delay: 0s;\n}\n\n.dx-hero-kicker {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n    font-size: 0.78rem;\n    font-weight: 700;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: var(--dx-text-2);\n}\n\n.dx-hero-kicker b {\n    font-family: \"Bebas Neue\", sans-serif;\n    font-size: 1.25rem;\n    font-weight: 400;\n    letter-spacing: 0.06em;\n    color: var(--dx-accent);\n}\n\n.dx-hero-logo {\n    display: block;\n    max-width: min(30rem, 100%);\n    max-height: 11rem;\n    object-fit: contain;\n    object-position: left bottom;\n    filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.55));\n}\n\n.dx-hero-title {\n    font-size: clamp(2.2rem, 4vw, 4rem);\n    font-weight: 800;\n    line-height: 1.02;\n    letter-spacing: -0.02em;\n    color: #fff;\n    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);\n}\n\n.dx-hero-meta {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.35rem 0.85rem;\n    font-size: 0.95rem;\n    font-weight: 500;\n    color: var(--dx-text-2);\n}\n\n.dx-hero-desc {\n    font-size: clamp(0.95rem, 1.05vw, 1.15rem);\n    line-height: 1.5;\n    color: rgba(255, 255, 255, 0.88);\n    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.55);\n    display: -webkit-box;\n    -webkit-line-clamp: 3;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n}\n\n.dx-hero-actions {\n    display: flex;\n    gap: 0.75rem;\n    margin-top: 0.35rem;\n}\n\n.dx-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 0.6rem;\n    height: 2.9rem;\n    padding: 0 1.6rem 0 1.3rem;\n    border-radius: var(--dx-radius);\n    font-size: 1.02rem;\n    font-weight: 700;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: background-color 0.2s, transform 0.2s var(--dx-ease-out), box-shadow 0.2s;\n}\n\n.dx-btn:active {\n    transform: scale(0.97);\n}\n\n.dx-btn svg {\n    width: 1.35rem;\n    height: 1.35rem;\n    flex: none;\n}\n\n.dx-btn-primary {\n    background: #fff;\n    color: #000;\n}\n\n.dx-btn-primary svg {\n    fill: #000;\n}\n\n.dx-btn-primary:hover {\n    background: rgba(255, 255, 255, 0.82);\n}\n\n.dx-btn-secondary {\n    background: rgba(109, 109, 118, 0.55);\n    color: #fff;\n    backdrop-filter: blur(8px);\n}\n\n.dx-btn-secondary svg {\n    fill: none;\n    stroke: #fff;\n}\n\n.dx-btn-secondary:hover {\n    background: rgba(109, 109, 118, 0.38);\n}\n\n/* Keyboard: the selected button comes forward in white, like a TV menu (dimming it the way the\n   mouse hover does read as \"off\" when nothing points at it) */\n.dx-btn:focus-visible {\n    background: #fff;\n    color: #000;\n    transform: scale(1.06);\n    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.45);\n}\n\n.dx-btn:focus-visible svg {\n    fill: #000;\n}\n\n.dx-btn-secondary:focus-visible svg {\n    fill: none;\n    stroke: #000;\n}\n\n.dx-hero-dots {\n    position: absolute;\n    z-index: 3;\n    right: var(--dx-gutter);\n    bottom: calc(6vw + 4.75rem);\n    display: flex;\n    gap: 0.4rem;\n}\n\n.dx-hero-dot {\n    position: relative;\n    width: 1.6rem;\n    height: 3px;\n    border-radius: 3px;\n    background: rgba(255, 255, 255, 0.25);\n    cursor: pointer;\n    overflow: hidden;\n    transition: width 0.4s var(--dx-ease-out), background-color 0.2s;\n}\n\n.dx-hero-dot:hover,\n.dx-hero-dot:focus-visible {\n    background: rgba(255, 255, 255, 0.45);\n}\n\n.dx-hero-dot.is-active {\n    width: 3.2rem;\n}\n\n.dx-hero-dot.is-active::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: #fff;\n    transform-origin: left;\n    animation: dx-progress var(--dx-hero-interval, 9s) linear both;\n}\n\n.dx-hero.is-static .dx-hero-dot.is-active::after {\n    animation: none;\n}\n\n@keyframes dx-progress {\n    from { transform: scaleX(0); }\n    to { transform: scaleX(1); }\n}\n\n/* Rows that follow the billboard sit above its fade */\n#app [class*=\"board-content-\"]:not([class*=\"board-content-container\"]) > .dx-hero ~ * {\n    position: relative;\n    z-index: 2;\n}\n\n/* Shared rating / meta pills */\n.dx-imdb {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.35rem;\n    font-weight: 700;\n    color: #fff;\n}\n\n.dx-imdb i {\n    font-style: normal;\n    font-size: 0.68em;\n    font-weight: 900;\n    letter-spacing: -0.01em;\n    line-height: 1;\n    padding: 0.18em 0.32em;\n    border-radius: 3px;\n    background: #f5c518;\n    color: #000;\n}\n\n.dx-match {\n    font-weight: 700;\n    color: #46d369;\n}\n\n.dx-pill {\n    display: inline-flex;\n    align-items: center;\n    height: 1.35rem;\n    padding: 0 0.45rem;\n    border: 1px solid rgba(255, 255, 255, 0.4);\n    border-radius: 3px;\n    font-size: 0.75rem;\n    font-weight: 600;\n    color: var(--dx-text-2);\n}\n\n.dx-sep {\n    width: 4px;\n    height: 4px;\n    border-radius: 50%;\n    background: var(--dx-text-3);\n}\n\n/* =====================================================================\n   7. CAROUSEL ARROWS + PREVIEW CARD + RATING BADGES (plugin parts)\n   ===================================================================== */\n\n.dx-arrow {\n    position: absolute;\n    z-index: 4;\n    bottom: 0.75rem;\n    width: calc(var(--dx-gutter) - 0.35rem);\n    min-width: 2.75rem;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #fff;\n    cursor: pointer;\n    opacity: 0;\n    transition: opacity 0.25s, background-color 0.25s;\n}\n\n.dx-arrow svg {\n    width: 2rem;\n    height: 2rem;\n    transform: scale(var(--dx-arrow-scale, 1));\n    transition: transform 0.25s var(--dx-ease-out);\n}\n\n.dx-arrow-prev {\n    left: 0;\n    background: linear-gradient(90deg, rgba(11, 11, 13, 0.92), rgba(11, 11, 13, 0.4));\n}\n\n.dx-arrow-next {\n    right: 0;\n    background: linear-gradient(270deg, rgba(11, 11, 13, 0.92), rgba(11, 11, 13, 0.4));\n}\n\n[class*=\"meta-row\"]:hover > .dx-arrow:not(.is-hidden) {\n    opacity: 1;\n}\n\n.dx-arrow:hover,\n.dx-arrow:focus-visible {\n    --dx-arrow-scale: 1.25;\n}\n\n.dx-arrow.is-hidden {\n    pointer-events: none;\n}\n\n/* Row page indicator */\n.dx-row-pages {\n    position: absolute;\n    top: 0.95rem;\n    right: var(--dx-gutter);\n    display: flex;\n    gap: 3px;\n    opacity: 0;\n    transition: opacity 0.3s;\n}\n\n[class*=\"meta-row\"]:hover > .dx-row-pages,\n[class*=\"meta-row\"]:focus-visible > .dx-row-pages {\n    opacity: 1;\n}\n\n.dx-row-pages span {\n    width: 0.8rem;\n    height: 2px;\n    background: rgba(255, 255, 255, 0.25);\n}\n\n.dx-row-pages span.is-active {\n    background: rgba(255, 255, 255, 0.85);\n}\n\n/* Header pushes \"See all\" left of the page dots */\n#app [class*=\"meta-row\"]:has(> .dx-row-pages) > [class*=\"header-container\"] {\n    padding-right: calc(var(--dx-gutter) + 6rem) !important;\n}\n\n/* IMDb badge on posters */\n.dx-badge {\n    position: absolute;\n    z-index: 4;\n    top: 0.45rem;\n    left: 0.45rem;\n    display: inline-flex;\n    align-items: center;\n    gap: 0.3rem;\n    height: 1.35rem;\n    padding: 0 0.4rem 0 0.25rem;\n    border-radius: 4px;\n    background: rgba(0, 0, 0, 0.72);\n    backdrop-filter: blur(6px);\n    font-size: 0.72rem;\n    font-weight: 700;\n    color: #fff;\n    pointer-events: none;\n    animation: dx-fade 0.4s both;\n}\n\n.dx-badge i {\n    font-style: normal;\n    font-size: 0.6rem;\n    font-weight: 900;\n    padding: 0.12rem 0.22rem;\n    border-radius: 2px;\n    background: #f5c518;\n    color: #000;\n    line-height: 1;\n}\n\n/* Anime scores (Kitsu / AniList) get their own colour so they never read as IMDb */\n.dx-badge.is-anime i {\n    background: #3db4f2;\n    color: #fff;\n}\n\n/* Continue Watching as wide cards */\n.dx-wide-art {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    background-size: cover;\n    background-position: center;\n    pointer-events: none;\n}\n\n.dx-wide-art::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(0deg, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.1) 45%, transparent 70%);\n}\n\n.dx-wide-logo {\n    position: absolute;\n    z-index: 2;\n    left: 0.85rem;\n    bottom: 1.15rem;\n    max-width: 55%;\n    max-height: 32%;\n    object-fit: contain;\n    object-position: left bottom;\n    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.7));\n}\n\n.dx-wide-name {\n    position: absolute;\n    z-index: 2;\n    left: 0.85rem;\n    right: 0.85rem;\n    bottom: 1.1rem;\n    font-size: 1rem;\n    font-weight: 700;\n    color: #fff;\n    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n#app [class*=\"continue-watching-row\"][data-dx-wide-row] [class*=\"poster-container\"] {\n    padding-top: 56.25% !important;\n}\n\n#app [class*=\"continue-watching-row\"][data-dx-wide-row] [class*=\"poster-image-layer\"] {\n    opacity: 0;\n}\n\n#app [class*=\"continue-watching-row\"][data-dx-wide-row] [class*=\"progress-bar-layer\"],\n#app [class*=\"continue-watching-row\"][data-dx-wide-row] [class*=\"play-icon-layer\"],\n#app [class*=\"continue-watching-row\"][data-dx-wide-row] [class*=\"new-videos\"],\n#app [class*=\"continue-watching-row\"][data-dx-wide-row] [class*=\"watched-icon-layer\"] {\n    z-index: 3;\n}\n\n/* Hover preview — unfolds out of the card like Netflix's mini-modal. The outer box carries the\n   shadow (it follows the clipped shape), the inner layer is revealed from the card's outline. */\n.dx-preview {\n    position: fixed;\n    z-index: 900;\n    opacity: 0;\n    visibility: hidden;\n    pointer-events: none;\n    will-change: transform, opacity;\n    transition:\n        transform 0.2s ease,\n        opacity 0.2s ease,\n        visibility 0s linear 0.2s;\n}\n\n.dx-preview.is-open {\n    opacity: 1;\n    visibility: visible;\n    pointer-events: auto;\n    transition: opacity 0.1s ease, visibility 0s;\n}\n\n.dx-preview.is-closing {\n    visibility: visible;\n    opacity: 0;\n    transform: scale(0.97) !important;\n    transition: transform 0.2s ease, opacity 0.2s ease;\n}\n\n.dx-preview-inner {\n    position: relative;\n    min-height: inherit;\n    display: flex;\n    flex-direction: column;\n    border-radius: 8px;\n    background: #181818;\n    overflow: hidden;\n    transition: clip-path 0.48s cubic-bezier(0.2, 0.85, 0.25, 1);\n    will-change: clip-path;\n}\n\n/* fine hairline so the panel's edge reads crisp against the page */\n.dx-preview-inner::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 6;\n    border-radius: inherit;\n    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);\n    pointer-events: none;\n}\n\n/* Aura: the title's own colours glowing softly around the panel once it has opened,\n   with a deep shadow underneath for lift */\n.dx-preview-aura {\n    position: absolute;\n    z-index: -1;\n    inset: -14px -18px -22px;\n    border-radius: 22px;\n    background: #181818 center / cover no-repeat;\n    filter: blur(30px) saturate(1.5) brightness(0.9);\n    opacity: 0;\n    transform: scale(0.92);\n    transition: opacity 0.55s ease 0.16s, transform 0.6s cubic-bezier(0.2, 0.85, 0.25, 1) 0.1s;\n    pointer-events: none;\n    will-change: opacity, transform;\n}\n\n.dx-preview::before {\n    content: \"\";\n    position: absolute;\n    z-index: -2;\n    inset: 10% 6% -4%;\n    border-radius: 18px;\n    background: rgba(0, 0, 0, 0.85);\n    filter: blur(28px);\n    opacity: 0;\n    transition: opacity 0.4s ease 0.12s;\n    pointer-events: none;\n}\n\n.dx-preview.is-open .dx-preview-aura {\n    opacity: 0.55;\n    transform: none;\n}\n\n.dx-preview.is-open::before {\n    opacity: 1;\n}\n\n.dx-preview.is-closing .dx-preview-aura,\n.dx-preview.is-closing::before {\n    transition-delay: 0s;\n}\n\n/* the card's own artwork, fading into the panel as it unfolds */\n.dx-preview-ghost {\n    position: absolute;\n    z-index: 5;\n    /* the same corners as the poster it grows out of */\n    border-radius: var(--dx-radius);\n    background: #222 center / cover no-repeat;\n    pointer-events: none;\n    opacity: 1;\n    /* fades only once the panel's artwork is showing around it: no see-through moment */\n    transition: opacity 0.3s ease 0.16s;\n    will-change: opacity;\n}\n\n.dx-preview.is-open .dx-preview-ghost {\n    opacity: 0;\n}\n\n/* details settle in just after the panel has opened */\n.dx-preview .dx-preview-body {\n    opacity: 0;\n    transform: translateY(8px);\n    transition: opacity 0.3s ease 0.16s, transform 0.4s cubic-bezier(0.2, 0.85, 0.25, 1) 0.14s;\n}\n\n.dx-preview.is-open .dx-preview-body {\n    opacity: 1;\n    transform: none;\n}\n\n.dx-preview-media {\n    position: relative;\n    aspect-ratio: 16 / 9;\n    background: #2a2a2a center / cover no-repeat;\n    cursor: pointer;\n}\n\n/* its own rounded top as well: the zooming artwork and the trailer are layers of their own, and\n   the panel's rounded clip alone can let their corners show square while the card unfolds */\n.dx-preview-media {\n    overflow: hidden;\n    border-radius: var(--dx-radius) var(--dx-radius) 0 0;\n}\n\n.dx-preview-media::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: inherit;\n    transform-origin: 60% 40%;\n}\n\n.dx-preview.is-open .dx-preview-media::before {\n    animation: dx-preview-zoom 6s ease-out both;\n}\n\n@keyframes dx-preview-zoom {\n    from { transform: scale(1); }\n    to { transform: scale(1.08); }\n}\n\n.dx-preview-media::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(0deg, #181818 0%, rgba(24, 24, 24, 0.35) 22%, transparent 45%);\n}\n\n.dx-preview-media img {\n    position: absolute;\n    z-index: 1;\n    left: 0.9rem;\n    bottom: 0.7rem;\n    max-width: 58%;\n    max-height: 40%;\n    object-fit: contain;\n    object-position: left bottom;\n    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.8));\n}\n\n.dx-preview-name {\n    position: absolute;\n    z-index: 1;\n    left: 0.9rem;\n    right: 0.9rem;\n    bottom: 0.7rem;\n    font-size: 1.2rem;\n    font-weight: 800;\n    line-height: 1.15;\n    color: #fff;\n    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);\n}\n\n.dx-preview-media.has-logo .dx-preview-name {\n    display: none;\n}\n\n\n.dx-preview-body {\n    flex: 1;\n    padding: 0.85rem 1rem 1.1rem;\n    display: flex;\n    flex-direction: column;\n    gap: 0.75rem;\n}\n\n.dx-preview-actions {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n}\n\n.dx-round {\n    position: relative;\n    width: 2.5rem;\n    height: 2.5rem;\n    flex: none;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 50%;\n    border: 2px solid rgba(255, 255, 255, 0.5);\n    background: rgba(42, 42, 42, 0.6);\n    color: #fff;\n    cursor: pointer;\n    transition: border-color 0.15s, background-color 0.15s;\n}\n\n.dx-round:hover,\n.dx-round:focus-visible {\n    border-color: #fff;\n    background: rgba(255, 255, 255, 0.1);\n}\n\n.dx-round svg {\n    width: 1.2rem;\n    height: 1.2rem;\n}\n\n.dx-round.is-primary {\n    background: #fff;\n    border-color: #fff;\n    color: #000;\n}\n\n.dx-round.is-primary:hover,\n.dx-round.is-primary:focus-visible {\n    background: rgba(255, 255, 255, 0.8);\n}\n\n.dx-round.is-primary svg {\n    margin-left: 2px;\n}\n\n.dx-round.is-end {\n    margin-left: auto;\n}\n\n/* Remove from Continue Watching: quieter than the others until pointed at */\n.dx-round.dx-remove {\n    border-color: rgba(255, 255, 255, 0.28);\n    color: rgba(255, 255, 255, 0.8);\n}\n\n.dx-round.dx-remove:hover,\n.dx-round.dx-remove:focus-visible {\n    border-color: var(--dx-accent);\n    background: color-mix(in srgb, var(--dx-accent) 22%, transparent);\n    color: #fff;\n}\n\n.dx-round.dx-remove + .dx-round {\n    margin-left: 0.5rem;\n}\n\n/* the last button's tooltip opens leftwards so the card's edge never cuts it off */\n.dx-preview-actions .dx-round:last-child[data-tip]::after {\n    left: auto;\n    right: 0;\n    transform: translate(0, 4px);\n}\n\n.dx-preview-actions .dx-round:last-child[data-tip]:hover::after,\n.dx-preview-actions .dx-round:last-child[data-tip]:focus-visible::after {\n    transform: none;\n}\n\n.dx-round.is-pop {\n    animation: dx-pop-btn 0.35s var(--dx-ease-out);\n}\n\n@keyframes dx-pop-btn {\n    40% { transform: scale(1.2); }\n}\n\n/* Small tooltip above the round buttons */\n.dx-round[data-tip]::after {\n    content: attr(data-tip);\n    position: absolute;\n    bottom: calc(100% + 0.6rem);\n    left: 50%;\n    transform: translate(-50%, 4px);\n    padding: 0.35rem 0.6rem;\n    border-radius: 4px;\n    background: #e6e6e6;\n    color: #111;\n    font-size: 0.78rem;\n    font-weight: 700;\n    white-space: nowrap;\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 0.15s, transform 0.15s;\n}\n\n.dx-round[data-tip]:hover::after,\n.dx-round[data-tip]:focus-visible::after {\n    opacity: 1;\n    transform: translate(-50%, 0);\n}\n\n.dx-round.is-end[data-tip]::after {\n    left: auto;\n    right: 0;\n    transform: translate(0, 4px);\n}\n\n.dx-round.is-end[data-tip]:hover::after,\n.dx-round.is-end[data-tip]:focus-visible::after {\n    transform: none;\n}\n\n.dx-preview-facts {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.3rem 0.55rem;\n    font-size: 0.88rem;\n    font-weight: 500;\n    color: #bcbcbc;\n}\n\n.dx-preview-facts .dx-match {\n    color: #46d369;\n    font-weight: 700;\n}\n\n.dx-hd {\n    padding: 0 0.3rem;\n    border: 1px solid rgba(255, 255, 255, 0.4);\n    border-radius: 3px;\n    font-size: 0.68rem;\n    font-weight: 700;\n    line-height: 1.3;\n    color: rgba(255, 255, 255, 0.85);\n}\n\n.dx-preview-genres {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.25rem 0.45rem;\n    font-size: 0.88rem;\n    color: #fff;\n}\n\n.dx-preview-genres span + span::before {\n    content: \"•\";\n    margin-right: 0.45rem;\n    color: #646464;\n}\n\n/* ---------- Intro (pre-rendered film, see plugin) ---------- */\n.dx-splash {\n    position: fixed;\n    inset: 0;\n    z-index: 100000;\n    background: #000;\n    cursor: pointer;\n    transition: opacity 0.6s ease, visibility 0.6s;\n}\n\n.dx-splash.is-done {\n    opacity: 0;\n    visibility: hidden;\n}\n\n.dx-splash-video {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    background: #000;\n}\n\n/* Fallback when video can't play: opacity/transform only, so it stays on the compositor */\n.dx-splash-mark {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    font-family: \"Bebas Neue\", \"Inter\", sans-serif;\n    font-size: clamp(5rem, 16vw, 18rem);\n    line-height: 1;\n    color: var(--dx-accent);\n    transform: translate(-50%, -50%);\n    animation: dx-intro-fallback 1.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;\n    will-change: transform, opacity;\n}\n\n@keyframes dx-intro-fallback {\n    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.92); }\n    30% { opacity: 1; transform: translate(-50%, -50%) scale(1); }\n    75% { opacity: 1; transform: translate(-50%, -50%) scale(1.04); }\n    100% { opacity: 0; transform: translate(-50%, -50%) scale(1.2); }\n}\n\n/* =====================================================================\n   8. DETAIL PAGE\n   ===================================================================== */\n\n#app [class*=\"metadetails-container\"] > [class*=\"background-image-layer\"] {\n    opacity: 1;\n}\n\n#app [class*=\"metadetails-container\"] > [class*=\"background-image-layer\"] img {\n    opacity: 1 !important;\n    filter: none !important;\n    object-fit: cover;\n    object-position: center 20%;\n    animation: dx-fade 0.9s var(--dx-ease) both;\n}\n\n#app [class*=\"metadetails-container\"] > [class*=\"background-image-layer\"]::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background:\n        linear-gradient(90deg, rgba(11, 11, 13, 0.94) 0%, rgba(11, 11, 13, 0.7) 32%, rgba(11, 11, 13, 0.12) 60%, rgba(11, 11, 13, 0.35) 100%),\n        linear-gradient(0deg, rgba(11, 11, 13, 0.9) 0%, transparent 38%),\n        linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, transparent 18%);\n}\n\n#app [class*=\"metadetails-container\"] > nav[class*=\"horizontal-nav-bar\"] {\n    height: var(--dx-nav-h);\n    padding: 0 var(--dx-gutter) 0 calc(var(--dx-gutter) - 0.6rem);\n    background: transparent;\n}\n\n#app [class*=\"metadetails-container\"] > nav [class*=\"back-button-container\"],\n#app [class*=\"player-container\"] nav [class*=\"back-button-container\"] {\n    height: 2.5rem;\n    width: 2.5rem;\n    margin: 0;\n    border-radius: 50%;\n    background: rgba(0, 0, 0, 0.45);\n    backdrop-filter: blur(8px);\n    transition: background-color 0.2s, transform 0.2s;\n}\n\n#app [class*=\"metadetails-container\"] > nav [class*=\"back-button-container\"]:hover,\n#app [class*=\"player-container\"] nav [class*=\"back-button-container\"]:hover,\n#app [class*=\"metadetails-container\"] > nav [class*=\"back-button-container\"]:focus-visible,\n#app [class*=\"player-container\"] nav [class*=\"back-button-container\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.16);\n    transform: translateX(-2px);\n}\n\n#app [class*=\"metadetails-content\"] {\n    padding-left: var(--dx-gutter);\n}\n\n#app [class*=\"metadetails-content\"] > [class*=\"meta-preview-container\"] {\n    padding-top: 1rem;\n    padding-bottom: 8vh;\n    justify-content: flex-end;\n}\n\n#app [class*=\"metadetails-content\"] > [class*=\"meta-preview-container\"] > [class*=\"meta-info-container\"] {\n    flex: 0 1 auto;\n}\n\n#app [class*=\"metadetails-content\"] > [class*=\"meta-preview-container\"] > [class*=\"action-buttons-container\"] {\n    margin-top: 1.75rem;\n}\n\n/* Meta preview (detail + discover side panel) */\n#app [class*=\"meta-preview-container\"] [class*=\"meta-info-container\"] {\n    padding-right: 1rem;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"logo\"] {\n    filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.6));\n    animation: dx-rise 0.6s var(--dx-ease-out) both;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"logo-placeholder\"] {\n    font-size: clamp(2rem, 3.4vw, 3.4rem);\n    font-weight: 800;\n    letter-spacing: -0.02em;\n    line-height: 1.05;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"runtime-release-info-container\"] {\n    gap: 1.1rem;\n    flex-wrap: wrap;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"runtime-label\"],\n#app [class*=\"meta-preview-container\"] [class*=\"release-info-label\"] {\n    font-size: 1rem;\n    font-weight: 600;\n    color: var(--dx-text-2);\n    margin: 0;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"imdb-button-container\"] {\n    height: 1.9rem;\n    padding: 0 0.6rem;\n    gap: 0.45rem;\n    border-radius: var(--dx-radius-s);\n    background: rgba(245, 197, 24, 0.12);\n    border: 1px solid rgba(245, 197, 24, 0.35);\n    transition: background-color 0.2s;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"imdb-button-container\"]:hover,\n#app [class*=\"meta-preview-container\"] [class*=\"imdb-button-container\"]:focus-visible {\n    background: rgba(245, 197, 24, 0.22);\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"imdb-button-container\"] [class*=\"label\"] {\n    font-weight: 800;\n    color: #fff;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"imdb-button-container\"] svg {\n    color: #f5c518;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"meta-links-container\"] [class*=\"label-container\"] {\n    font-size: 0.72rem;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: var(--dx-text-3);\n    opacity: 1;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"link-container\"] {\n    display: inline-flex !important;\n    align-items: center;\n    justify-content: center;\n    height: 2rem;\n    /* optical centring: the font reserves descender space below, so nudge capitals down */\n    padding: 0.15em 0.85rem 0 !important;\n    line-height: 1 !important;\n    vertical-align: middle;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.07);\n    border: 1px solid var(--dx-line);\n    font-size: 0.85rem;\n    font-weight: 500;\n    color: var(--dx-text);\n    transition: background-color 0.2s, border-color 0.2s;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"link-container\"]:hover,\n#app [class*=\"meta-preview-container\"] [class*=\"link-container\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.14);\n    border-color: var(--dx-line-strong);\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"description-container\"] {\n    font-size: 1.02rem;\n    line-height: 1.6;\n    color: rgba(255, 255, 255, 0.86);\n    max-width: 48rem;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"description-container\"] [class*=\"label-container\"] {\n    display: none;\n}\n\n/* Action buttons: first (Play/Trailer) is a solid button, the rest are round */\n#app [class*=\"meta-preview-container\"] [class*=\"action-buttons-container\"] {\n    gap: 0.6rem;\n    align-items: center;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"action-button-container\"],\n#app [class*=\"meta-preview-container\"] [class*=\"group-container\"] {\n    height: 3rem;\n    min-width: 3rem;\n    border-radius: 999px;\n    background: rgba(42, 42, 48, 0.65);\n    border: 1.5px solid rgba(255, 255, 255, 0.28);\n    backdrop-filter: blur(10px);\n    transition: background-color 0.2s, border-color 0.2s, transform 0.2s var(--dx-ease-out);\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"action-button-container\"]:hover,\n#app [class*=\"meta-preview-container\"] [class*=\"action-button-container\"]:focus-visible {\n    border-color: #fff;\n    background: rgba(255, 255, 255, 0.12);\n    transform: translateY(-1px);\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"group-container\"] [class*=\"icon-container\"] {\n    border-radius: 999px;\n    transition: background-color 0.2s;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"group-container\"] [class*=\"icon-container\"]:hover,\n#app [class*=\"meta-preview-container\"] [class*=\"group-container\"] [class*=\"icon-container\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.12);\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"action-button-container\"][class*=\"wide\"] {\n    padding: 0 1.5rem 0 1.15rem;\n    border-radius: var(--dx-radius);\n    background: #fff;\n    border-color: #fff;\n    color: #000;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"action-button-container\"][class*=\"wide\"] * {\n    color: #000 !important;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"action-button-container\"][class*=\"wide\"] [class*=\"label\"] {\n    font-weight: 700;\n    font-size: 1rem;\n}\n\n#app [class*=\"meta-preview-container\"] [class*=\"action-button-container\"][class*=\"wide\"]:hover,\n#app [class*=\"meta-preview-container\"] [class*=\"action-button-container\"][class*=\"wide\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.84);\n}\n\n/* Episodes / streams panel */\n#app [class*=\"metadetails-content\"] [class*=\"videos-list-container\"],\n#app [class*=\"metadetails-content\"] [class*=\"streams-list-container\"] {\n    flex: 0 0 clamp(28rem, 31vw, 42rem) !important;\n    width: clamp(28rem, 31vw, 42rem);\n    margin: 0.75rem var(--dx-gutter) 1.5rem 0;\n    border-radius: var(--dx-radius-l);\n    background: rgba(19, 19, 23, 0.82);\n    border: 1px solid var(--dx-line);\n    backdrop-filter: blur(24px) saturate(140%);\n    box-shadow: var(--dx-shadow-2);\n    animation: dx-slide-in 0.5s var(--dx-ease-out) both;\n}\n\n@keyframes dx-slide-in {\n    from { opacity: 0; transform: translateX(24px); }\n    to { opacity: 1; transform: none; }\n}\n\n#app [class*=\"seasons-bar-container\"] {\n    padding: 0.5rem 0.75rem;\n    border-bottom: 1px solid var(--dx-line);\n}\n\n#app [class*=\"seasons-bar-container\"] [class*=\"button-container\"] {\n    border-radius: var(--dx-radius);\n}\n\n#app [class*=\"seasons-bar-container\"] [class*=\"button-container\"]:hover,\n#app [class*=\"seasons-bar-container\"] [class*=\"button-container\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.07);\n}\n\n#app [class*=\"seasons-popup-label-container\"] [class*=\"button-container\"] {\n    background: rgba(255, 255, 255, 0.07);\n    border: 1px solid var(--dx-line);\n    font-weight: 700;\n}\n\n#app [class*=\"videos-list-container\"] [class*=\"search-bar-container\"] {\n    margin: 0.75rem;\n    border-radius: var(--dx-radius);\n    background: rgba(255, 255, 255, 0.05);\n    border: 1px solid var(--dx-line);\n}\n\n#app [class*=\"video-container\"] {\n    margin: 0 0.5rem;\n    border-radius: var(--dx-radius);\n    transition: background-color 0.2s;\n}\n\n#app [class*=\"video-container\"]:hover,\n#app [class*=\"video-container\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.06);\n}\n\n#app [class*=\"video-container\"][class*=\"selected\"] {\n    background: rgba(255, 255, 255, 0.09);\n    box-shadow: inset 3px 0 0 var(--dx-accent);\n}\n\n#app [class*=\"video-container\"] [class*=\"thumbnail-container\"] {\n    border-radius: var(--dx-radius-s);\n    overflow: hidden;\n}\n\n#app [class*=\"video-container\"] [class*=\"title-container\"] {\n    font-weight: 600;\n    color: var(--dx-text);\n}\n\n#app [class*=\"video-container\"] [class*=\"released-container\"] {\n    color: var(--dx-text-3);\n}\n\n#app [class*=\"video-container\"] [class*=\"upcoming-watched-container\"] > * {\n    border-radius: var(--dx-radius-s);\n}\n\n#app [class*=\"video-container\"] [class*=\"watched-container\"] {\n    background: rgba(70, 211, 105, 0.15);\n    color: #46d369;\n}\n\n#app [class*=\"streams-list-container\"] [class*=\"select-choices-wrapper\"] {\n    padding: 0.5rem 0.75rem;\n    border-bottom: 1px solid var(--dx-line);\n}\n\n#app [class*=\"streams-list-container\"] [class*=\"stream-container\"] {\n    margin: 0.2rem 0.5rem;\n    border-radius: var(--dx-radius);\n    transition: background-color 0.2s, transform 0.2s var(--dx-ease-out);\n}\n\n#app [class*=\"streams-list-container\"] [class*=\"stream-container\"]:hover,\n#app [class*=\"streams-list-container\"] [class*=\"stream-container\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.07);\n    transform: translateX(3px);\n}\n\n/* A stream's right-click menu lives inside its card: lift that card above the ones after it,\n   otherwise they paint over the menu */\n#app [class*=\"streams-list-container\"] [class*=\"stream-container\"]:has([class*=\"menu-container\"]) {\n    position: relative;\n    z-index: 40;\n    transform: none;\n}\n\n#app [class*=\"streams-list-container\"] [class*=\"stream-container\"] [class*=\"menu-container\"] {\n    z-index: 41;\n}\n\n#app [class*=\"streams-list-container\"] [class*=\"streams-container\"] > [class*=\"stream-container\"] {\n    align-self: stretch;\n    width: auto !important;\n    padding: 0.8rem 1rem;\n}\n\n#app [class*=\"streams-list-container\"] [class*=\"stream-container\"] [class*=\"info-container\"] {\n    width: 8.5rem;\n}\n\n#app [class*=\"streams-list-container\"] [class*=\"stream-container\"] [class*=\"description-container\"] {\n    max-width: none !important;\n    flex: 1 1 0 !important;\n    white-space: pre-wrap !important;\n    overflow-wrap: anywhere;\n    max-height: none !important;\n    font-size: 0.85rem;\n    line-height: 1.45;\n}\n\n#app [class*=\"streams-list-container\"] [class*=\"addon-name\"] {\n    font-weight: 700;\n    color: var(--dx-text);\n}\n\n#app [class*=\"streams-list-container\"] [class*=\"description-container\"] {\n    color: var(--dx-text-2);\n}\n\n/* =====================================================================\n   9. DISCOVER / LIBRARY / SEARCH / CALENDAR\n   ===================================================================== */\n\n#app [class*=\"discover-content\"],\n#app [class*=\"library-content\"],\n#app [class*=\"search-content\"] {\n    padding-top: 0.75rem;\n}\n\n#app [class*=\"search-content\"] {\n    padding-left: 0 !important;\n    padding-right: 0 !important;\n}\n\n#app [class*=\"discover-content\"] [class*=\"catalog-container\"] {\n    padding-left: calc(var(--dx-gutter) - 0.35rem);\n}\n\n#app [class*=\"library-content\"] {\n    padding-left: calc(var(--dx-gutter) - 0.35rem);\n    padding-right: calc(var(--dx-gutter) - 0.35rem);\n}\n\n#app [class*=\"selectable-inputs-container\"] {\n    gap: 0.6rem;\n    padding: 0 0.35rem 0.75rem;\n}\n\n/* Dropdowns / filters / chips */\n#app [class*=\"multiselect-menu\"] > [class*=\"button-container\"],\n#app [class*=\"select-input\"] > [class*=\"button-container\"],\n#app [class*=\"filter-button\"],\n#app [class*=\"selectable-inputs\"] [class*=\"button-container\"] {\n    height: 2.5rem;\n    border-radius: var(--dx-radius);\n    background: var(--dx-surface);\n    border: 1px solid var(--dx-line);\n    transition: background-color 0.2s, border-color 0.2s;\n}\n\n#app [class*=\"multiselect-menu\"] > [class*=\"button-container\"]:hover,\n#app [class*=\"filter-button\"]:hover,\n#app [class*=\"multiselect-menu\"] > [class*=\"button-container\"]:focus-visible,\n#app [class*=\"filter-button\"]:focus-visible {\n    background: var(--dx-surface-2);\n    border-color: var(--dx-line-strong);\n}\n\n#app [class*=\"multiselect-menu\"] [class*=\"text\"] {\n    font-size: 0.9rem;\n    font-weight: 600;\n}\n\n#app [class*=\"chips\"] [class*=\"chip\"] {\n    height: 2.2rem;\n    padding: 0 1rem;\n    border-radius: 999px;\n    background: var(--dx-surface);\n    border: 1px solid var(--dx-line);\n    font-size: 0.85rem;\n    font-weight: 600;\n    color: var(--dx-text-2);\n    transition: background-color 0.2s, color 0.2s, border-color 0.2s;\n}\n\n#app [class*=\"chips\"] [class*=\"chip\"]:hover,\n#app [class*=\"chips\"] [class*=\"chip\"]:focus-visible {\n    color: var(--dx-text);\n    border-color: var(--dx-line-strong);\n}\n\n#app [class*=\"chips\"] [class*=\"chip\"][class*=\"active\"] {\n    background: #fff;\n    border-color: #fff;\n    color: #000;\n}\n\n/* Grids */\n#app [class*=\"discover-content\"] [class*=\"meta-items-container\"],\n#app [class*=\"library-content\"] [class*=\"meta-items-container\"] {\n    grid-template-columns: repeat(auto-fill, minmax(clamp(9.5rem, 11vw, 13rem), 1fr)) !important;\n    gap: 0.35rem 0;\n    padding-bottom: 3rem;\n}\n\n/* Discover side preview */\n#app [class*=\"discover-content\"] > [class*=\"meta-preview-container\"] {\n    margin: 0 var(--dx-gutter) 1.25rem 0.75rem;\n    border-radius: var(--dx-radius-l);\n    background: var(--dx-bg-raised);\n    border: 1px solid var(--dx-line);\n    overflow: hidden;\n    box-shadow: var(--dx-shadow-2);\n}\n\n#app [class*=\"discover-content\"] > [class*=\"meta-preview-container\"] [class*=\"background-image-layer\"] img {\n    opacity: 0.55;\n    filter: none;\n}\n\n#app [class*=\"discover-content\"] > [class*=\"meta-preview-container\"] [class*=\"background-image-layer\"]::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(0deg, var(--dx-bg-raised) 20%, rgba(19, 19, 23, 0.55) 60%, rgba(19, 19, 23, 0.3) 100%);\n}\n\n/* Empty / message states */\n#app [class*=\"message-container\"],\n#app [class*=\"placeholder-label\"] {\n    color: var(--dx-text-3);\n}\n\n/* Calendar */\n#app [class*=\"calendar\"] [class*=\"selector\"] {\n    gap: 1rem;\n}\n\n#app [class*=\"calendar\"] [class*=\"selector\"] [class*=\"button-container\"] {\n    border-radius: var(--dx-radius);\n    background: var(--dx-surface);\n    border: 1px solid var(--dx-line);\n}\n\n#app [class*=\"calendar\"] [class*=\"cell\"] {\n    border-radius: var(--dx-radius);\n    background: var(--dx-bg-raised);\n    border: 1px solid var(--dx-line);\n    transition: background-color 0.2s, border-color 0.2s;\n}\n\n#app [class*=\"calendar\"] [class*=\"cell\"]:hover,\n#app [class*=\"calendar\"] [class*=\"cell\"]:focus-visible {\n    background: var(--dx-surface);\n    border-color: var(--dx-line-strong);\n}\n\n#app [class*=\"calendar\"] [class*=\"cell\"][class*=\"today\"] {\n    border-color: var(--dx-accent);\n    box-shadow: inset 0 0 0 1px var(--dx-accent);\n}\n\n#app [class*=\"calendar\"] [class*=\"cell\"][class*=\"today\"] [class*=\"day\"] {\n    color: #fff;\n    font-weight: 800;\n}\n\n#app [class*=\"calendar\"] [class*=\"list-\"] [class*=\"item-\"] {\n    border-radius: var(--dx-radius);\n}\n\n#app [class*=\"calendar\"] [class*=\"episode-\"] {\n    border-radius: var(--dx-radius);\n    transition: background-color 0.2s;\n}\n\n#app [class*=\"calendar\"] [class*=\"episode-\"]:hover,\n#app [class*=\"calendar\"] [class*=\"episode-\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.06);\n}\n\n#app [class*=\"calendar\"] [class*=\"artwork-container\"] {\n    border-radius: var(--dx-radius-s);\n    overflow: hidden;\n}\n\n/* =====================================================================\n   10. ADDONS + SETTINGS\n   ===================================================================== */\n\n#app [class*=\"addons-content\"] {\n    padding: 0.75rem calc(var(--dx-gutter) - 0.35rem) 0;\n}\n\n#app [class*=\"addons-content\"] [class*=\"add-button-container\"] {\n    height: 2.5rem;\n    padding: 0 1.1rem;\n    border-radius: var(--dx-radius);\n    background: var(--dx-accent);\n    transition: background-color 0.2s;\n}\n\n#app [class*=\"addons-content\"] [class*=\"add-button-container\"]:hover,\n#app [class*=\"addons-content\"] [class*=\"add-button-container\"]:focus-visible {\n    background: var(--dx-accent-hover);\n}\n\n#app [class*=\"addons-content\"] [class*=\"add-button-container\"] * {\n    color: #fff !important;\n    font-weight: 700;\n}\n\n#app [class*=\"addons-content\"] label[class*=\"search-bar-container\"] {\n    height: 2.5rem;\n    border-radius: var(--dx-radius);\n    background: var(--dx-surface);\n    border: 1px solid var(--dx-line);\n}\n\n#app [class*=\"addons-list-container\"] {\n    gap: 0.75rem;\n    padding-bottom: 2rem;\n}\n\n#app [class*=\"addons-list-container\"] [class*=\"addon-container\"] {\n    margin: 0 0 0.75rem 0;\n    padding: 1.1rem 1.25rem;\n    border-radius: var(--dx-radius-l);\n    background: var(--dx-bg-raised);\n    border: 1px solid var(--dx-line);\n    transition: background-color 0.25s, border-color 0.25s, transform 0.25s var(--dx-ease-out);\n}\n\n#app [class*=\"addons-list-container\"] [class*=\"addon-container\"]:hover,\n#app [class*=\"addons-list-container\"] [class*=\"addon-container\"]:focus-visible {\n    background: var(--dx-surface);\n    border-color: var(--dx-line-strong);\n}\n\n#app [class*=\"addon-container\"] [class*=\"logo-container\"] {\n    border-radius: var(--dx-radius);\n    background: var(--dx-surface-2);\n    overflow: hidden;\n}\n\n#app [class*=\"addon-container\"] [class*=\"name-container\"] {\n    font-weight: 700;\n}\n\n#app [class*=\"addon-container\"] [class*=\"version-container\"],\n#app [class*=\"addon-container\"] [class*=\"types-container\"] {\n    color: var(--dx-text-3);\n}\n\n#app [class*=\"addon-container\"] [class*=\"description-container\"] {\n    color: var(--dx-text-2);\n}\n\n/* Install / uninstall / configure / share */\n#app [class*=\"install-button-container\"],\n#app [class*=\"configure-button-container\"] {\n    border-radius: var(--dx-radius) !important;\n    background: var(--dx-accent) !important;\n    border: 0 !important;\n    transition: background-color 0.2s, opacity 0.2s;\n}\n\n#app [class*=\"install-button-container\"]:hover,\n#app [class*=\"configure-button-container\"]:hover,\n#app [class*=\"install-button-container\"]:focus-visible,\n#app [class*=\"configure-button-container\"]:focus-visible {\n    background: var(--dx-accent-hover) !important;\n}\n\n#app [class*=\"install-button-container\"] *,\n#app [class*=\"configure-button-container\"] * {\n    color: #fff !important;\n}\n\n#app [class*=\"uninstall-button-container\"],\n#app [class*=\"share-button-container\"] {\n    border-radius: var(--dx-radius) !important;\n    background: var(--dx-surface-2) !important;\n    border: 1px solid var(--dx-line) !important;\n    outline: none !important;\n}\n\n#app [class*=\"uninstall-button-container\"]:hover,\n#app [class*=\"share-button-container\"]:hover,\n#app [class*=\"uninstall-button-container\"]:focus-visible,\n#app [class*=\"share-button-container\"]:focus-visible {\n    background: var(--dx-surface-3) !important;\n}\n\n#app [class*=\"uninstall-button-container\"] *,\n#app [class*=\"share-button-container\"] * {\n    color: var(--dx-text) !important;\n}\n\n/* Settings */\n#app [class*=\"settings-content\"] {\n    padding: 0.75rem var(--dx-gutter) 0;\n    gap: 2rem;\n}\n\n#app [class*=\"settings-content\"] > [class*=\"menu-\"] {\n    padding: 0.5rem;\n    border-radius: var(--dx-radius-l);\n    background: var(--dx-bg-raised);\n    border: 1px solid var(--dx-line);\n    height: fit-content;\n    max-height: 100%;\n}\n\n#app [class*=\"settings-content\"] > [class*=\"menu-\"] > [class*=\"button\"],\n#app [class*=\"settings-content\"] > [class*=\"menu-\"] > div > [class*=\"button\"] {\n    height: 2.75rem;\n    margin: 0.1rem 0;\n    padding: 0 1rem;\n    border-radius: var(--dx-radius);\n    font-weight: 600;\n    color: var(--dx-text-2);\n    opacity: 1;\n    transition: background-color 0.2s, color 0.2s;\n}\n\n#app [class*=\"settings-content\"] > [class*=\"menu-\"] [class*=\"button\"]:hover,\n#app [class*=\"settings-content\"] > [class*=\"menu-\"] [class*=\"button\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.06);\n    color: var(--dx-text);\n}\n\n#app [class*=\"settings-content\"] > [class*=\"menu-\"] [class*=\"button\"][class*=\"selected\"] {\n    background: rgba(255, 255, 255, 0.1);\n    color: #fff;\n    box-shadow: inset 3px 0 0 var(--dx-accent);\n}\n\n#app [class*=\"settings-content\"] [class*=\"section-\"] {\n    border-bottom: 1px solid var(--dx-line);\n}\n\n#app [class*=\"settings-content\"] [class*=\"heading-\"] {\n    font-weight: 700;\n}\n\n#app [class*=\"settings-content\"] [class*=\"option-\"] [class*=\"content-\"] [class*=\"button-container\"],\n#app [class*=\"settings-content\"] [class*=\"multiselect-menu\"] > [class*=\"button-container\"] {\n    border-radius: var(--dx-radius);\n}\n\n#app [class*=\"settings-content\"] [class*=\"user-info-content\"] [class*=\"avatar\"],\n#app [class*=\"settings-content\"] [class*=\"user-info-content\"] img {\n    border-radius: var(--dx-radius) !important;\n}\n\n/* Toggles and checkboxes */\n#app [class*=\"toggle-container\"] [class*=\"toggle\"] {\n    background: var(--dx-surface-3);\n}\n\n#app [class*=\"toggle-container\"].checked [class*=\"toggle\"],\n#app .checked > [class*=\"toggle\"] {\n    background: var(--dx-accent) !important;\n}\n\n#app [class*=\"checkbox-container\"].checked [class*=\"checkbox\"],\n#app [class*=\"checkbox\"].checked {\n    background: var(--dx-accent) !important;\n    border-color: var(--dx-accent) !important;\n}\n\n/* Keyboard: a selected switch or choice glows softly and grows a touch (they have no hover look\n   to borrow) */\n#app [class*=\"toggle-container\"]:focus-visible,\n#app [class*=\"radio-container\"]:focus-visible,\n#app [class*=\"checkbox-container\"]:focus-visible {\n    filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.5));\n    transform: scale(1.08);\n    transition: transform 0.2s var(--dx-ease-out), filter 0.2s;\n}\n\n/* Text inputs */\n#app input[class*=\"text-input\"],\n#app [class*=\"text-input\"] input {\n    border-radius: var(--dx-radius);\n}\n\n/* =====================================================================\n   11. POPUPS, MENUS, MODALS, TOASTS, TOOLTIPS\n   ===================================================================== */\n\n#app [class*=\"menu-container\"][class*=\"menu-direction\"]:not([class*=\"context-menu\"]),\n#app [class*=\"nav-menu-container\"] {\n    border-radius: var(--dx-radius-l) !important;\n    background: rgba(22, 22, 27, 0.97) !important;\n    border: 1px solid var(--dx-line-strong) !important;\n    box-shadow: var(--dx-shadow-2) !important;\n    backdrop-filter: blur(20px);\n    overflow: hidden;\n}\n\n/* Animate the menu's content, never the container: other plugins hide containers with inline opacity */\n#app [class*=\"menu-container\"][class*=\"menu-direction\"] > * {\n    animation: dx-pop 0.18s var(--dx-ease-out) both;\n}\n\n@keyframes dx-pop {\n    from { opacity: 0; transform: translateY(-4px) scale(0.98); }\n    to { opacity: 1; transform: none; }\n}\n\n#app [class*=\"nav-menu-container\"] [class*=\"nav-menu-option-container\"],\n#app [class*=\"menu-container\"] [class*=\"option-container\"] {\n    border-radius: var(--dx-radius);\n    transition: background-color 0.15s;\n}\n\n#app [class*=\"nav-menu-container\"] [class*=\"nav-menu-option-container\"]:hover,\n#app [class*=\"menu-container\"] [class*=\"option-container\"]:hover,\n#app [class*=\"nav-menu-container\"] [class*=\"nav-menu-option-container\"]:focus-visible,\n#app [class*=\"menu-container\"] [class*=\"option-container\"]:focus-visible {\n    background: rgba(255, 255, 255, 0.08) !important;\n}\n\n#app [class*=\"menu-container\"] [class*=\"option-container\"][class*=\"selected\"] {\n    background: rgba(255, 255, 255, 0.1) !important;\n}\n\n#app [class*=\"nav-menu-container\"] [class*=\"nav-menu-section\"] {\n    border-color: var(--dx-line) !important;\n}\n\n#app [class*=\"modal-container\"] {\n    background: rgba(0, 0, 0, 0.7);\n    backdrop-filter: blur(6px);\n    animation: dx-fade 0.2s both;\n}\n\n#app [class*=\"modal-dialog-container\"] {\n    border-radius: var(--dx-radius-l) !important;\n    background: var(--dx-surface) !important;\n    border: 1px solid var(--dx-line) !important;\n    box-shadow: var(--dx-shadow-2) !important;\n}\n\n/* The content sits inside the dialog: one card only, not a second inset one */\n#app [class*=\"modal-dialog-container\"] [class*=\"modal-dialog-content\"] {\n    border-radius: 0 !important;\n    background: transparent !important;\n    border: 0 !important;\n    box-shadow: none !important;\n}\n\n#app [class*=\"modal-dialog-container\"] {\n    animation: dx-pop 0.25s var(--dx-ease-out) both;\n}\n\n#app [class*=\"modal-dialog-container\"] [class*=\"action-button\"],\n#app [class*=\"modal-dialog-container\"] [class*=\"button-container\"][class*=\"action\"] {\n    border-radius: var(--dx-radius) !important;\n}\n\n#app [class*=\"toasts-container\"] [class*=\"toast-item-container\"] {\n    border-radius: var(--dx-radius) !important;\n    background: var(--dx-surface-2) !important;\n    border: 1px solid var(--dx-line) !important;\n    border-left: 3px solid var(--dx-accent) !important;\n    box-shadow: var(--dx-shadow-2) !important;\n    animation: dx-slide-in 0.35s var(--dx-ease-out) both;\n}\n\n#app [class*=\"toasts-container\"] [class*=\"toast-item-container\"][class*=\"success\"] {\n    border-left-color: #46d369 !important;\n}\n\n#app [class*=\"toasts-container\"] [class*=\"toast-item-container\"][class*=\"error\"] {\n    border-left-color: #ff5a5f !important;\n}\n\n#app [class*=\"tooltip-container\"] {\n    border-radius: var(--dx-radius-s) !important;\n    background: #fff !important;\n    color: #000 !important;\n    font-weight: 600;\n    font-size: 0.8rem;\n}\n\n/* =====================================================================\n   12. PLAYER — Netflix-style controls and panels\n   ===================================================================== */\n\n/* Top bar: just a large back arrow (title moves to the bottom when the plugin is on) */\n#app [class*=\"player-container\"] [class*=\"nav-bar-layer\"] {\n    background: linear-gradient(180deg, rgba(0, 0, 0, 0.7) 0%, transparent 100%) !important;\n    height: 7rem;\n}\n\n#app [class*=\"player-container\"] [class*=\"player-nav\"] {\n    padding: 1.5rem var(--dx-gutter) 0 calc(var(--dx-gutter) - 0.75rem) !important;\n    align-items: center;\n}\n\n#app [class*=\"player-container\"] [class*=\"player-nav\"] [class*=\"player-button\"] {\n    width: 3.25rem;\n    height: 3.25rem;\n    border-radius: 50%;\n    background: transparent !important;\n    transition: transform 0.2s var(--dx-ease-out);\n}\n\n#app [class*=\"player-container\"] [class*=\"player-nav\"] [class*=\"player-button\"]:hover,\n#app [class*=\"player-container\"] [class*=\"player-nav\"] [class*=\"player-button\"]:focus-visible {\n    transform: scale(1.15);\n}\n\n/* Some Windows installs drew the back arrow unsized: a black chevron across the whole video that\n   sent every click back to the streams list. Keep top-bar icons small and click-through always. */\n#app [class*=\"player-container\"] [class*=\"nav-bar-layer\"] svg {\n    max-width: 3rem !important;\n    max-height: 3rem !important;\n    pointer-events: none !important;\n}\n\n#app [class*=\"player-container\"] [class*=\"player-nav\"] [class*=\"player-button\"] svg {\n    width: 2.1rem;\n    height: 2.1rem;\n    color: #fff;\n}\n\n#app [class*=\"player-container\"] [class*=\"player-title\"] {\n    font-size: 1.15rem;\n    font-weight: 600;\n    color: var(--dx-text-2);\n}\n\nbody[data-dx-ptitle] #app [class*=\"player-container\"] [class*=\"player-title-container\"] {\n    visibility: hidden;\n}\n\n/* Bottom bar */\n#app [class*=\"player-container\"] [class*=\"control-bar-layer\"] {\n    padding: 5rem var(--dx-gutter) 1.4rem !important;\n    background: linear-gradient(0deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.5) 45%, transparent 100%) !important;\n}\n\n#app [class*=\"player-container\"] [class*=\"control-bar-layer\"] [class*=\"seek-bar-container\"] {\n    height: 2.25rem;\n    gap: 1rem;\n}\n\n#app [class*=\"player-container\"] [class*=\"seek-bar-container\"] [class*=\"label\"] {\n    font-size: 0.95rem;\n    font-weight: 600;\n    font-variant-numeric: tabular-nums;\n    color: var(--dx-text);\n    opacity: 1;\n}\n\n#app [class*=\"player-container\"] [class*=\"seek-bar-container\"] > [class*=\"button-container\"] {\n    background: transparent !important;\n    padding: 0 0.25rem;\n}\n\n#app [class*=\"slider-container\"] [class*=\"track\"] {\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.25) !important;\n}\n\n#app [class*=\"slider-container\"] [class*=\"track-before\"] {\n    background: rgba(255, 255, 255, 0.45) !important;\n}\n\n#app [class*=\"slider-container\"] [class*=\"track-after\"] {\n    background: var(--dx-accent) !important;\n}\n\n#app [class*=\"slider-container\"] [class*=\"thumb\"] {\n    background: var(--dx-accent) !important;\n    box-shadow: none !important;\n    transition: transform 0.15s var(--dx-ease-out);\n    transform-origin: center;\n}\n\n#app [class*=\"player-container\"] [class*=\"seek-bar-container\"] [class*=\"slider-container\"] {\n    --track-size: calc(4px + 3px * var(--dx-seek-hot, 0));\n    --thumb-size: 16px;\n}\n\n#app [class*=\"player-container\"] [class*=\"seek-bar-container\"]:hover,\n#app [class*=\"player-container\"] [class*=\"seek-bar-container\"]:focus-visible {\n    --dx-seek-hot: 1;\n}\n\n/* Stremio centres the knob with translateX(-50%) — keep that, only add the scale */\n#app [class*=\"player-container\"] [class*=\"seek-bar-container\"] [class*=\"thumb\"] {\n    transform: translateX(-50%) scale(calc(1.15 * var(--dx-seek-hot, 0)));\n}\n\nhtml[class*=\"active-slider-within\"] #app [class*=\"player-container\"] [class*=\"seek-bar-container\"] [class*=\"thumb\"] {\n    transform: translateX(-50%) scale(1.15);\n}\n\n/* Button row */\n#app [class*=\"player-container\"] [class*=\"control-bar-buttons-container\"] {\n    position: relative;\n    gap: 0.35rem;\n    margin-top: 0.35rem;\n    border-radius: 0 !important;\n    background: transparent !important;\n    transform: none !important;\n}\n\n#app [class*=\"player-container\"] [class*=\"control-bar-buttons-container\"] > * {\n    order: 3;\n}\n\n#app [class*=\"player-container\"] [class*=\"control-bar-buttons-container\"] > [class*=\"control-bar-button-\"]:first-child {\n    order: 0;\n}\n\n#app [class*=\"player-container\"] [class*=\"control-bar-buttons-container\"] > .dx-seek-back {\n    order: 1;\n}\n\n#app [class*=\"player-container\"] [class*=\"control-bar-buttons-container\"] > .dx-seek-fwd {\n    order: 2;\n}\n\n#app [class*=\"player-container\"] [class*=\"control-bar-buttons-menu-container\"] {\n    gap: 0.35rem;\n    border-radius: 0 !important;\n    background: transparent !important;\n}\n\n#app [class*=\"player-container\"] [class*=\"control-bar-button-\"],\n#app [class*=\"player-container\"] [class*=\"control-bar-buttons-menu-button\"],\n#app [class*=\"player-container\"] .dxp-player-btn,\n.dx-seek {\n    width: 3.5rem !important;\n    height: 3.5rem !important;\n    border-radius: 50% !important;\n    background: transparent !important;\n    transform: none !important;\n}\n\n#app [class*=\"player-container\"] [class*=\"control-bar-button-\"] svg,\n#app [class*=\"player-container\"] [class*=\"control-bar-buttons-menu-button\"] svg,\n#app [class*=\"player-container\"] .dxp-player-btn svg,\n.dx-seek svg {\n    width: 2.15rem !important;\n    height: 2.15rem !important;\n    color: #fff;\n    opacity: 1 !important;\n    transform: scale(var(--dx-btn-scale, 1));\n    transition: transform 0.18s var(--dx-ease-out);\n}\n\n#app [class*=\"player-container\"] [class*=\"control-bar-button-\"]:hover:not(.disabled),\n#app [class*=\"player-container\"] [class*=\"control-bar-buttons-menu-button\"]:hover,\n.dx-seek:hover,\n#app [class*=\"player-container\"] [class*=\"control-bar-button-\"]:focus-visible,\n#app [class*=\"player-container\"] [class*=\"control-bar-buttons-menu-button\"]:focus-visible,\n#app [class*=\"player-container\"] .dxp-player-btn:hover,\n#app [class*=\"player-container\"] .dxp-player-btn:focus-visible,\n.dx-seek:focus-visible {\n    --dx-btn-scale: 1.22;\n}\n\n#app [class*=\"player-container\"] [class*=\"control-bar-button-\"].disabled svg {\n    opacity: 0.3 !important;\n}\n\n#app [class*=\"player-container\"] [class*=\"control-bar-button-\"].active svg,\n#app [class*=\"player-container\"] [class*=\"control-bar-button-\"][class*=\"active\"] svg {\n    color: #fff;\n    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.5));\n}\n\n.dx-seek {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: #fff;\n    cursor: pointer;\n}\n\n/* Volume: slider slides out when you point at the speaker */\n#app [class*=\"player-container\"] [class*=\"control-bar-buttons-container\"] > [class*=\"volume-slider\"] {\n    flex