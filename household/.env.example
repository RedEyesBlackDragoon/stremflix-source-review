# Generate secrets with tools/household/Start-Local.ps1; never commit .env.
POSTGRES_PASSWORD=
BOOTSTRAP_TOKEN=
DATABASE_URL=postgresql+psycopg://household:CHANGE_ME@db:5432/household
ENVIRONMENT=production
# Explicit operator allowlist. No signed-in scraping, stream providers, credential paths or query tokens.
CATALOG_HOST_ALLOWLIST=v3-cinemeta.strem.io,cinemeta-catalogs.strem.io
PUBLIC_HOST=household.example.com
