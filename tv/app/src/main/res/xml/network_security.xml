<?xml version="1.0" encoding="utf-8"?>
<!-- Streams and Stremio's streaming server are often plain http on the local network -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
